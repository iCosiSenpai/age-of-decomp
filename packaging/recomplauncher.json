    },
    {
      "id": "rumble_curve",
      "label": "Rumble curve",
      "help": "Lower values make light rumble stronger; 1 is linear.",
      "group": "Controls",
      "advanced": true,
      "slider": {
        "key": "rumble_curve",
        "min": 0.2,
        "max": 1.5,
        "step": 0.05,
        "format": "%.2f"
      },
      "defaults": {
        "rumble_curve": "0.6"
