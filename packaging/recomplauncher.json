{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Age of Decomp",
  "repo": "iCosiSenpai/age-of-decomp",
  "system": {
    "windows": {
      "version": "10",
      "graphics": {
        "vulkan": "1.3"
      }
    }
  },
  "inputs": [
    {
      "id": "nup",
      "label": "Your Age of Imprisonment .nup with update 1.0.3",
      "role": "game",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "nup"
          ]
        }
      ],
      "check": {
        "nup_build_id": "659cb288b5c5b2b49853add616c0d5bf4ea4e1ba"
      }
    },
    {
      "id": "dlc",
      "label": "Your DLC dump (.nup), if you have it",
      "role": "dlc",
      "optional": true,
      "formats": [
        {
          "type": "file",
          "extensions": [
            "nup"
          ]
        }
      ]
    },
    {
      "id": "dlss",
      "label": "NVIDIA DLSS",
      "role": "runtime",
      "shared": "nvidia.dlss",
      "optional": true
    }
  ],
  "prepare": {
    "program": [
      "AgeOfDecomp.exe",
      "AgeOfDecomp-x86_64.AppImage"
    ],
    "args": [
      "cli",
      "prepare",
      "--game",
      "{input:nup}",
      "--out",
      "{install}/game",
      "--dlc={input:dlc}"
    ],
    "label": "Building the game for this PC from your copy (about 10 minutes on a fast PC)",
    "done": [
      "{install}/game/aod-ready-v5.json"
    ],
    "options": [
      {
        "id": "frame_gen",
        "label": "NVIDIA frame generation",
        "note": "Downloads NVIDIA's frame generation file (7 MB) from NVIDIA. For GeForce RTX 40 and 50 cards.",
        "gpu": "nvidia",
        "os": [
          "windows"
        ],
        "args": [
          "--fetch-frame-gen",
          "--accept-nvidia-license"
        ],
        "license": {
          "name": "NVIDIA RTX SDKs license",
          "url": "https://github.com/NVIDIA/DLSS/blob/v310.9.16/LICENSE.txt"
        }
      }
    ]
  },
  "start": {
    "program": [
      "AgeOfDecomp.exe",
      "AgeOfDecomp-x86_64.AppImage"
    ],
    "args": [
      "--play",
      "--game-dir",
      "{install}/game",
      "--game={input:nup}",
      "--dlss={input:dlss}"
    ]
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        {
          "path": "{install}/game/work/build/hwaoi196608/hwaoi.ini"
        }
      ],
      "new": {
        "output_res": "auto",
        "render_scale": "100",
        "fps_limit": "60"
      }
    }
  ],
  "settings": [
    {
      "id": "output_res",
      "label": "Game resolution",
      "help": "The size the game draws its picture in. Automatic takes your screen's size when a dedicated graphics card has the memory for it: 12 GB for 1440p, 16 GB for 4K. A size your card has too little memory for can stop the game while it loads.",
      "group": "Display",
      "choices": [
        {
          "label": "Automatic",
          "set": {
            "output_res": "auto"
          }
        },
        {
          "label": "720p",
          "set": {
            "output_res": "1280x720"
          }
        },
        {
          "label": "1080p",
          "set": {
            "output_res": "1920x1080"
          }
        },
        {
          "label": "1440p",
          "set": {
            "output_res": "2560x1440"
          }
        },
        {
          "label": "4K",
          "set": {
            "output_res": "3840x2160"
          }
        }
      ],
      "defaults": {
        "output_res": "auto"
      }
    },
    {
      "id": "fullscreen",
      "label": "Fullscreen",
      "help": "Fills the screen with a borderless window. F11 switches it while you play.",
      "group": "Display",
      "choices": [
        {
          "label": "Off",
          "set": {
            "fullscreen": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "fullscreen": "1"
          }
        }
      ],
      "defaults": {
        "fullscreen": "0"
      }
    },
    {
      "id": "window_size",
      "label": "Window size",
      "help": "The size of the window when not in fullscreen.",
      "group": "Display",
      "choices": [
        {
          "label": "1280 × 720",
          "set": {
            "window_size": "1280x720"
          }
        },
        {
          "label": "1600 × 900",
          "set": {
            "window_size": "1600x900"
          }
        },
        {
          "label": "1920 × 1080",
          "set": {
            "window_size": "1920x1080"
          }
        },
        {
          "label": "2560 × 1440",
          "set": {
            "window_size": "2560x1440"
          }
        }
      ],
      "defaults": {
        "window_size": "1280x720",
        "fullscreen": "0"
      },
      "when": {
        "fullscreen": "0"
      }
    },
    {
      "id": "fps_limit",
      "label": "Frame rate",
      "help": "60 is the game's normal speed. 30 saves power.",
      "group": "Display",
      "choices": [
        {
          "label": "30 FPS",
          "set": {
            "fps_limit": "30"
          }
        },
        {
          "label": "60 FPS",
          "set": {
            "fps_limit": "60"
          }
        }
      ],
      "defaults": {
        "fps_limit": "60"
      }
    },
    {
      "id": "vk_present",
      "label": "Screen sync",
      "help": "How finished frames reach the screen. Fast shows the newest frame without tearing. V-Sync waits for the screen. Off has the least delay and can tear.",
      "group": "Display",
      "choices": [
        {
          "label": "Fast",
          "set": {
            "vk_present": "mailbox"
          }
        },
        {
          "label": "V-Sync",
          "set": {
            "vk_present": "fifo"
          }
        },
        {
          "label": "Off",
          "set": {
            "vk_present": "immediate"
          }
        }
      ],
      "defaults": {
        "vk_present": "mailbox",
        "frame_gen": "off"
      },
      "when": {
        "frame_gen": "off"
      }
    },
    {
      "id": "render_scale",
      "label": "3D rendering",
      "help": "Native draws the 3D scene at the game resolution: the sharpest picture. As on the console runs the game's own path, a 1600×900 scene scaled to 1080p: softer and lighter, and the game resolution is then 1080p.",
      "group": "Display",
      "choices": [
        {
          "label": "Native",
          "set": {
            "render_scale": "100"
          }
        },
        {
          "label": "As on the console",
          "set": {
            "render_scale": "game"
          }
        }
      ],
      "defaults": {
        "render_scale": "100"
      }
    },
    {
      "id": "temporal",
      "label": "Upscaling",
      "help": "Rebuilds the 3D picture from several frames: cleaner edges and, at a lower quality, more speed. AMD FSR works on most graphics cards and is downloaded from AMD the first time. NVIDIA DLSS needs an RTX card and NVIDIA's own DLSS file.",
      "group": "Display",
      "choices": [
        {
          "label": "Off",
          "set": {
            "temporal": "off"
          }
        },
        {
          "label": "AMD FSR",
          "set": {
            "temporal": "fsr"
          }
        },
        {
          "label": "NVIDIA DLSS",
          "set": {
            "temporal": "dlss"
          }
        }
      ],
      "defaults": {
        "temporal": "off"
      }
    },
    {
      "id": "dlss_quality",
      "label": "DLSS quality",
      "help": "DLAA keeps the full 3D resolution and only cleans the edges. Quality, Balanced and Performance draw the 3D scene smaller and scale it up: faster, a little softer.",
      "group": "Display",
      "choices": [
        {
          "label": "DLAA",
          "set": {
            "dlss_quality": "native"
          }
        },
        {
          "label": "Quality",
          "set": {
            "dlss_quality": "quality"
          }
        },
        {
          "label": "Balanced",
          "set": {
            "dlss_quality": "balanced"
          }
        },
        {
          "label": "Performance",
          "set": {
            "dlss_quality": "performance"
          }
        }
      ],
      "defaults": {
        "dlss_quality": "native",
        "temporal": "off"
      },
      "when": {
        "temporal": "dlss"
      }
    },
    {
      "id": "fsr_quality",
      "label": "FSR quality",
      "help": "Native keeps the full 3D resolution and only cleans the edges. Quality, Balanced and Performance draw the 3D scene smaller and scale it up: faster, a little softer.",
      "group": "Display",
      "choices": [
        {
          "label": "Native",
          "set": {
            "fsr_quality": "native"
          }
        },
        {
          "label": "Quality",
          "set": {
            "fsr_quality": "quality"
          }
        },
        {
          "label": "Balanced",
          "set": {
            "fsr_quality": "balanced"
          }
        },
        {
          "label": "Performance",
          "set": {
            "fsr_quality": "performance"
          }
        }
      ],
      "defaults": {
        "fsr_quality": "native",
        "temporal": "off"
      },
      "when": {
        "temporal": "fsr"
      }
    },
    {
      "id": "frame_gen",
      "label": "Frame generation",
      "help": "NVIDIA DLSS draws extra frames between the game's own, so motion looks smoother on a fast screen: 4x turns 60 frames per second into 240. The game itself does not run faster, and your input is felt a little later. Needs a GeForce RTX 40 or 50 card and NVIDIA's own frame generation file. Pick a number your screen can show. While it is on, Screen sync is Off.",
      "group": "Display",
      "choices": [
        {
          "label": "Off",
          "set": {
            "frame_gen": "off"
          }
        },
        {
          "label": "2x",
          "set": {
            "frame_gen": "2"
          }
        },
        {
          "label": "3x",
          "set": {
            "frame_gen": "3"
          }
        },
        {
          "label": "4x",
          "set": {
            "frame_gen": "4"
          }
        },
        {
          "label": "5x",
          "set": {
            "frame_gen": "5"
          }
        },
        {
          "label": "6x",
          "set": {
            "frame_gen": "6"
          }
        }
      ],
      "defaults": {
        "frame_gen": "off"
      }
    },
    {
      "id": "antialiasing",
      "label": "Edge smoothing",
      "help": "SMAA smooths jagged edges in the finished picture on any graphics card, at a small cost. With FSR or DLSS it is not needed.",
      "group": "Display",
      "choices": [
        {
          "label": "Off",
          "set": {
            "antialiasing": "off"
          }
        },
        {
          "label": "SMAA",
          "set": {
            "antialiasing": "smaa"
          }
        }
      ],
      "defaults": {
        "antialiasing": "off"
      }
    },
    {
      "id": "upscaler",
      "label": "Fit to the window",
      "help": "How the finished picture is scaled when the window is larger than the game resolution. AMD FSR 1 keeps edges sharper than Bilinear.",
      "group": "Display",
      "advanced": true,
      "choices": [
        {
          "label": "AMD FSR 1",
          "set": {
            "upscaler": "fsr"
          }
        },
        {
          "label": "Bilinear",
          "set": {
            "upscaler": "bilinear"
          }
        }
      ],
      "defaults": {
        "upscaler": "fsr"
      }
    },
    {
      "id": "sharpness",
      "label": "Sharpness",
      "help": "Sharpening after the picture is scaled. 0 turns it off.",
      "group": "Display",
      "advanced": true,
      "slider": {
        "key": "sharpness",
        "min": 0,
        "max": 100,
        "step": 5,
        "format": "%.0f"
      },
      "defaults": {
        "sharpness": "80",
        "upscaler": "fsr"
      },
      "when": {
        "upscaler": "fsr"
      }
    },
    {
      "id": "aspect",
      "label": "Picture shape",
      "help": "The game's picture is 16:9. On a screen of another shape, keep it with black bars or stretch it over the whole window. On a 16:9 screen the two look the same.",
      "group": "Display",
      "choices": [
        {
          "label": "Black bars",
          "set": {
            "aspect": "fit"
          }
        },
        {
          "label": "Stretch",
          "set": {
            "aspect": "stretch"
          }
        }
      ],
      "defaults": {
        "aspect": "fit"
      }
    },
    {
      "id": "perf_overlay",
      "label": "Performance overlay",
      "help": "Frame rate and timings in a corner of the game. F10 cycles it while you play.",
      "group": "Display",
      "choices": [
        {
          "label": "Off",
          "set": {
            "perf_overlay": "off"
          }
        },
        {
          "label": "FPS",
          "set": {
            "perf_overlay": "fps"
          }
        },
        {
          "label": "Full",
          "set": {
            "perf_overlay": "full"
          }
        }
      ],
      "defaults": {
        "perf_overlay": "off"
      }
    },
    {
      "id": "device_profile",
      "label": "Device profile",
      "help": "Steam Deck starts with lighter settings for handheld PCs. Automatic chooses it on a Steam Deck.",
      "group": "Display",
      "advanced": true,
      "choices": [
        {
          "label": "Automatic",
          "set": {
            "device_profile": "auto"
          }
        },
        {
          "label": "Desktop",
          "set": {
            "device_profile": "desktop"
          }
        },
        {
          "label": "Steam Deck",
          "set": {
            "device_profile": "deck"
          }
        }
      ],
      "defaults": {
        "device_profile": "auto"
      }
    },
    {
      "id": "color_preset",
      "label": "Colour",
      "help": "The game's own colours, a more vivid look, extra clarity, deeper blacks for OLED screens, or your own values below.",
      "group": "Picture",
      "choices": [
        {
          "label": "Game's own",
          "set": {
            "color_preset": "default"
          }
        },
        {
          "label": "Vivid",
          "set": {
            "color_preset": "vivid"
          }
