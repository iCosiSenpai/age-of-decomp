          "label": "Clarity",
          "set": {
            "color_preset": "clarity"
          }
        },
        {
          "label": "OLED",
          "set": {
            "color_preset": "oled"
          }
        },
        {
          "label": "Custom",
          "set": {
            "color_preset": "custom"
          }
        }
      ],
      "defaults": {
        "color_preset": "default"
      }
    },
    {
      "id": "color_brightness",
      "label": "Brightness",
      "help": "Lighter or darker picture.",
      "group": "Picture",
      "slider": {
        "key": "color_brightness",
        "min": -30,
        "max": 30,
        "step": 1,
        "format": "%.0f"
      },
      "defaults": {
        "color_brightness": "0",
        "color_preset": "default"
      },
      "when": {
        "color_preset": "custom"
      }
    },
    {
      "id": "color_contrast",
      "label": "Contrast",
