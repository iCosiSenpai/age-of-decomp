{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Age of Decomp",
  "repo": "iCosiSenpai/age-of-decomp",
  "system": {
    "windows": {
      "version": "10",
      "graphics": {
        "vulkan": "1.3"
      }
    }
  },
  "inputs": [
    {
      "id": "nup",
      "label": "Your Age of Imprisonment .nup with update 3.0.0",
      "role": "game",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "nup"
          ]
        }
      ]
    },
    {
      "id": "dlc",
      "label": "Your DLC dump (.nup), if you have it",
      "role": "dlc",
      "optional": true,
      "formats": [
        {
          "type": "file",
          "extensions": [
            "nup"
          ]
        }
      ]
    },
    {
      "id": "dlss",
      "label": "NVIDIA DLSS",
      "role": "runtime",
      "shared": "nvidia.dlss",
      "optional": true
    }
  ],
  "prepare": {
    "program": [
      "aod-cli.exe",
      "AgeOfDecomp-x86_64.AppImage"
    ],
    "args": [
      "cli",
      "prepare",
      "--game",
      "{input:nup}",
      "--out",
      "{install}/game",
      "--dlc={input:dlc}"
    ],
    "label": "Building the game for this PC from your copy (about 10 minutes on a fast PC)",
    "timeout": 14400,
    "version": "4",
    "done": [
      "{install}/game/aod-ready-v4.json"
    ]
  },
  "start": {
    "program": [
      "AgeOfDecomp.exe",
      "AgeOfDecomp-x86_64.AppImage"
    ],
    "args": [
      "--play",
      "--game-dir",
      "{install}/game",
      "--game={input:nup}",
      "--dlss={input:dlss}"
    ]
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        {
          "path": "{install}/game/work/build/hwaoi196608/hwaoi.ini"
        }
      ],
      "new": {
        "output_res": "1920x1080",
        "render_scale": "100",
        "fps_limit": "60"
      }
    }
  ],
  "settings": [
    {
      "id": "output_res",
      "label": "Resolution",
      "help": "What the game draws at. 1080p is the tested baseline; 1440p and 4K are experimental (menus and movies may not scale yet).",
      "group": "Display",
      "choices": [
        {
          "label": "720p",
          "set": {
            "output_res": "1280x720"
          }
        },
        {
          "label": "1080p",
          "set": {
            "output_res": "1920x1080"
          }
        },
        {
          "label": "1440p (experimental)",
          "set": {
            "output_res": "2560x1440"
          }
        },
        {
          "label": "4K (experimental)",
          "set": {
            "output_res": "3840x2160"
          }
        }
      ],
      "defaults": {
        "output_res": "1920x1080"
      }
    },
    {
      "id": "fullscreen",
      "label": "Fullscreen",
      "help": "Fill the screen. F11 switches it while you play.",
      "group": "Display",
      "choices": [
        {
          "label": "Off",
          "set": {
            "fullscreen": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "fullscreen": "1"
          }
        }
      ],
      "defaults": {
        "fullscreen": "0"
      }
    },
    {
      "id": "window_size",
      "label": "Window size",
      "help": "The size of the window when not in fullscreen.",
      "group": "Display",
      "choices": [
        {
          "label": "1280 × 720",
          "set": {
            "window_size": "1280x720"
          }
        },
        {
          "label": "1600 × 900",
          "set": {
            "window_size": "1600x900"
          }
        },
        {
          "label": "1920 × 1080",
          "set": {
            "window_size": "1920x1080"
          }
        },
        {
          "label": "2560 × 1440",
          "set": {
            "window_size": "2560x1440"
          }
        }
      ],
      "defaults": {
        "window_size": "1280x720",
        "fullscreen": "0"
      },
      "when": {
        "fullscreen": "0"
      }
    },
    {
      "id": "fps_limit",
      "label": "Frame rate",
      "help": "60 is the game's normal speed. 30 saves power.",
      "group": "Display",
      "choices": [
        {
          "label": "30 FPS",
          "set": {
            "fps_limit": "30"
          }
        },
        {
          "label": "60 FPS",
          "set": {
            "fps_limit": "60"
          }
        }
      ],
      "defaults": {
        "fps_limit": "60"
      }
    },
    {
      "id": "vk_present",
      "label": "V-Sync",
      "help": "Mailbox shows the newest frame without tearing. V-Sync waits for the screen. Immediate has the lowest latency but can tear.",
      "group": "Display",
      "choices": [
        {
          "label": "Mailbox",
          "set": {
            "vk_present": "mailbox"
          }
        },
        {
          "label": "V-Sync",
          "set": {
            "vk_present": "fifo"
          }
        },
        {
          "label": "Off (tearing)",
          "set": {
            "vk_present": "immediate"
          }
        }
      ],
      "defaults": {
        "vk_present": "mailbox"
      }
    },
    {
      "id": "render_scale",
      "label": "3D resolution",
      "help": "Native draws the 3D scene at the full resolution: sharpest, with no smoothing of edges. Console is the game's own: a 1600×900 scene its upscaler brings to 1080p, softer with steadier edges, lower in busy scenes. Console always draws at 1080p.",
      "group": "Display",
      "choices": [
        {
          "label": "Native",
          "set": {
            "render_scale": "100"
          }
        },
        {
          "label": "Console (1080p)",
          "set": {
            "render_scale": "game"
          }
        }
      ],
      "defaults": {
        "render_scale": "100"
      }
    },
    {
      "id": "temporal",
      "label": "Anti-aliasing",
      "help": "Smooths jagged, shimmering edges in the 3D scene at Native 3D resolution. NVIDIA DLAA needs an RTX card and NVIDIA's own DLSS file.",
      "group": "Display",
      "choices": [
        {
          "label": "Off",
          "set": {
            "temporal": "off"
          }
        },
        {
          "label": "NVIDIA DLAA",
          "set": {
            "temporal": "dlaa"
          }
        }
      ],
      "defaults": {
        "temporal": "off"
      }
    },
    {
      "id": "upscaler",
      "label": "Upscaling",
      "help": "How the picture is fitted to your screen. AMD FSR keeps it sharp on any graphics card.",
      "group": "Display",
      "choices": [
        {
          "label": "AMD FSR 1",
          "set": {
            "upscaler": "fsr"
          }
        },
        {
          "label": "Bilinear",
          "set": {
            "upscaler": "bilinear"
          }
        }
      ],
      "defaults": {
        "upscaler": "fsr"
      }
    },
    {
      "id": "sharpness",
      "label": "Sharpness",
      "help": "FSR sharpening. 0 is soft, 100 is crisp.",
      "group": "Display",
      "slider": {
        "key": "sharpness",
        "min": 0,
        "max": 100,
        "step": 5,
        "format": "%.0f"
      },
      "defaults": {
        "sharpness": "80",
        "upscaler": "fsr"
      },
      "when": {
        "upscaler": "fsr"
      }
    },
    {
      "id": "aspect",
      "label": "Aspect ratio",
      "help": "Keep 16:9 adds borders on other screens. Stretch fills them.",
      "group": "Display",
      "choices": [
        {
          "label": "Keep 16:9",
          "set": {
            "aspect": "fit"
          }
        },
        {
          "label": "Stretch",
          "set": {
            "aspect": "stretch"
          }
        }
      ],
      "defaults": {
        "aspect": "fit"
      }
    },
    {
      "id": "perf_overlay",
      "label": "Performance overlay",
      "help": "Frame rate and timings in a corner of the game. F10 cycles it while you play.",
      "group": "Display",
      "choices": [
        {
          "label": "Off",
          "set": {
            "perf_overlay": "off"
          }
        },
        {
          "label": "FPS",
          "set": {
            "perf_overlay": "fps"
          }
        },
        {
          "label": "Full",
          "set": {
            "perf_overlay": "full"
          }
        }
      ],
      "defaults": {
        "perf_overlay": "off"
      }
    },
    {
      "id": "device_profile",
      "label": "Device profile",
      "help": "Steam Deck uses lighter defaults for handheld PCs.",
      "group": "Display",
      "advanced": true,
      "choices": [
        {
          "label": "Automatic",
          "set": {
            "device_profile": "auto"
          }
        },
        {
          "label": "Desktop",
          "set": {
            "device_profile": "desktop"
          }
        },
        {
          "label": "Steam Deck",
          "set": {
            "device_profile": "deck"
          }
        }
      ],
      "defaults": {
        "device_profile": "auto"
      }
    },
    {
      "id": "color_preset",
      "label": "Colour",
      "help": "Game's own colours, a more vivid look, extra clarity, or your own values below.",
      "group": "Picture",
      "choices": [
        {
          "label": "Game's own",
          "set": {
            "color_preset": "default"
          }
        },
        {
          "label": "Vivid",
          "set": {
            "color_preset": "vivid"
          }
        },
        {
          "label": "Clarity",
          "set": {
            "color_preset": "clarity"
          }
        },
        {
          "label": "Custom",
          "set": {
            "color_preset": "custom"
          }
        }
      ],
      "defaults": {
        "color_preset": "default"
      }
    },
    {
      "id": "color_brightness",
      "label": "Brightness",
      "help": "Lighter or darker picture.",
      "group": "Picture",
      "slider": {
        "key": "color_brightness",
        "min": -30,
        "max": 30,
        "step": 1,
        "format": "%.0f"
      },
      "defaults": {
        "color_brightness": "0",
        "color_preset": "default"
      },
      "when": {
        "color_preset": "custom"
      }
    },
    {
      "id": "color_contrast",
      "label": "Contrast",
      "help": "Difference between light and dark.",
      "group": "Picture",
      "slider": {
        "key": "color_contrast",
        "min": 70,
        "max": 150,
        "step": 1,
        "format": "%.0f"
      },
      "defaults": {
        "color_contrast": "100",
        "color_preset": "default"
      },
      "when": {
        "color_preset": "custom"
      }
    },
    {
      "id": "color_saturation",
      "label": "Saturation",
      "help": "Colour strength.",
      "group": "Picture",
      "slider": {
        "key": "color_saturation",
        "min": 50,
        "max": 200,
        "step": 1,
        "format": "%.0f"
      },
      "defaults": {
        "color_saturation": "100",
        "color_preset": "default"
      },
      "when": {
        "color_preset": "custom"
      }
    },
    {
      "id": "color_gamma",
      "label": "Gamma",
      "help": "Mid-tone brightness.",
      "group": "Picture",
      "slider": {
        "key": "color_gamma",
        "min": 0.8,
        "max": 1.2,
        "step": 0.01,
        "format": "%.2f"
      },
      "defaults": {
        "color_gamma": "1",
        "color_preset": "default"
      },
      "when": {
        "color_preset": "custom"
      }
    },
    {
      "id": "lang",
      "label": "Game language",
      "help": "The language of the game's text and voices menu. Automatic follows your system.",
      "group": "Game",
      "choices": [
        {
          "label": "Automatic",
          "set": {
            "lang": ""
          }
        },
        {
          "label": "English (US)",
          "set": {
            "lang": "en-US"
          }
        },
        {
          "label": "English (UK)",
          "set": {
            "lang": "en-GB"
          }
        },
        {
          "label": "Italiano",
          "set": {
            "lang": "it"
          }
        },
        {
          "label": "Français",
          "set": {
            "lang": "fr"
          }
        },
        {
          "label": "Français (Canada)",
          "set": {
            "lang": "fr-CA"
          }
        },
        {
          "label": "Deutsch",
          "set": {
            "lang": "de"
          }
        },
        {
          "label": "Español",
          "set": {
            "lang": "es"
          }
        },
        {
          "label": "Español (Latinoamérica)",
          "set": {
            "lang": "es-419"
          }
        },
        {
          "label": "Nederlands",
          "set": {
            "lang": "nl"
          }
        },
        {
          "label": "Português",
          "set": {
            "lang": "pt"
          }
        },
        {
          "label": "Português (Brasil)",
          "set": {
            "lang": "pt-BR"
          }
        },
        {
          "label": "Русский",
          "set": {
            "lang": "ru"
          }
        },
        {
          "label": "日本語",
          "set": {
            "lang": "ja"
          }
        },
        {
          "label": "한국어",
          "set": {
            "lang": "ko"
          }
        },
        {
          "label": "简体中文",
          "set": {
            "lang": "zh-Hans"
          }
        },
        {
          "label": "繁體中文",
          "set": {
            "lang": "zh-Hant"
          }
        }
      ],
      "defaults": {
        "lang": ""
      }
    },
    {
      "id": "menu_lang",
      "label": "In-game menu language",
      "help": "The language of the settings menu you open with Esc, and of the overlay. Automatic follows your system.",
      "group": "Game",
      "choices": [
        {
          "label": "Automatic",
          "set": {
            "menu_lang": ""
          }
        },
        {
          "label": "English",
          "set": {
            "menu_lang": "en"
          }
        },
        {
          "label": "Italiano",
          "set": {
            "menu_lang": "it"
          }
        },
        {
          "label": "Русский",
          "set": {
            "menu_lang": "ru"
          }
        }
      ],
      "defaults": {
        "menu_lang": ""
      }
    },
    {
      "id": "operation_mode",
      "label": "Console mode",
      "help": "Docked is the TV mode. Handheld uses the console's portable settings, lighter on slower PCs.",
      "group": "Game",
      "choices": [
        {
          "label": "Docked",
          "set": {
            "operation_mode": "docked"
          }
        },
        {
          "label": "Handheld",
          "set": {
            "operation_mode": "handheld"
          }
        }
      ],
      "defaults": {
        "operation_mode": "docked"
      }
    },
    {
      "id": "assume_focus",
      "label": "Keep running in the background",
      "help": "Off pauses the game when you switch to another window.",
      "group": "Game",
      "choices": [
        {
          "label": "Off",
          "set": {
            "assume_focus": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "assume_focus": "1"
          }
        }
      ],
      "defaults": {
        "assume_focus": "1"
      }
    },
    {
      "id": "volume",
      "label": "Master volume",
      "help": "Above 100 % boosts quiet speakers.",
      "group": "Audio",
      "slider": {
        "key": "volume",
        "min": 0,
        "max": 300,
        "step": 5,
        "format": "%.0f"
      },
      "defaults": {
        "volume": "100"
      }
    },
    {
      "id": "mute_unfocused",
      "label": "Mute in the background",
      "help": "Silences the game while another window is in front.",
      "group": "Audio",
      "choices": [
        {
          "label": "Off",
          "set": {
            "mute_unfocused": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "mute_unfocused": "1"
          }
        }
      ],
      "defaults": {
        "mute_unfocused": "0"
      }
    },
    {
      "id": "audio_latency",
      "label": "Audio buffer",
      "help": "Raise it if the sound crackles or drops out. Low reacts fastest.",
      "group": "Audio",
      "choices": [
        {
          "label": "Low (10 ms)",
          "set": {
            "audio_latency": "low"
          }
        },
        {
          "label": "Normal (20 ms)",
          "set": {
            "audio_latency": "normal"
          }
        },
        {
          "label": "High (40 ms)",
          "set": {
            "audio_latency": "high"
          }
        }
      ],
      "defaults": {
        "audio_latency": "low"
      }
    },
    {
      "id": "player1_type",
      "label": "Player 1 controller",
      "help": "What the game sees: one Pro Controller, or a pair of Joy-Con.",
      "group": "Controls",
      "choices": [
        {
          "label": "Pro Controller",
          "set": {
            "player1_type": "pro"
          }
        },
        {
          "label": "Joy-Con pair",
          "set": {
            "player1_type": "dual"
          }
        }
      ],
      "defaults": {
        "player1_type": "pro"
      }
    },
    {
      "id": "player2_type",
      "label": "Player 2 controller",
      "help": "What the game sees for player 2.",
      "group": "Controls",
      "choices": [
        {
          "label": "Pro Controller",
          "set": {
            "player2_type": "pro"
          }
        },
        {
          "label": "Joy-Con pair",
          "set": {
            "player2_type": "dual"
          }
        }
      ],
      "defaults": {
        "player2_type": "pro"
      }
    },
    {
      "id": "pad_layout",
      "label": "Button layout",
      "help": "Nintendo keeps A on the right. Xbox puts A at the bottom. Xbox labels makes the button marked A confirm on any pad.",
      "group": "Controls",
      "choices": [
        {
          "label": "Automatic",
          "set": {
            "pad_layout": "auto"
          }
        },
        {
          "label": "Nintendo",
          "set": {
            "pad_layout": "nintendo"
          }
        },
        {
          "label": "Xbox positions",
          "set": {
            "pad_layout": "xbox"
          }
        },
        {
          "label": "Xbox labels",
          "set": {
            "pad_layout": "xbox_prompts"
          }
        }
      ],
      "defaults": {
        "pad_layout": "auto"
      }
    },
    {
      "id": "stick_deadzone",
      "label": "Stick dead zone",
      "help": "Raise it if the camera or character drifts on its own.",
      "group": "Controls",
      "slider": {
        "key": "stick_deadzone",
        "min": 0,
        "max": 50,
        "step": 1,
        "format": "%.0f"
      },
      "defaults": {
        "stick_deadzone": "8"
      }
    },
    {
      "id": "motion",
      "label": "Motion controls",
      "help": "Gyro and accelerometer from controllers that have them (Switch, Switch 2, DualSense, DualShock 4).",
      "group": "Controls",
      "choices": [
        {
          "label": "Off",
          "set": {
            "motion": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "motion": "1"
          }
        }
      ],
      "defaults": {
        "motion": "1"
      }
    },
    {
      "id": "rumble_strength",
      "label": "Rumble strength",
      "help": "0 turns rumble off.",
      "group": "Controls",
      "slider": {
        "key": "rumble_strength",
        "min": 0,
        "max": 300,
        "step": 10,
        "format": "%.0f"
      },
      "defaults": {
        "rumble_strength": "130"
