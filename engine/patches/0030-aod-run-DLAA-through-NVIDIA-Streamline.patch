diff --git a/runtime/vk_dlaa.c b/runtime/vk_dlaa.c
new file mode 100644
index 0000000000000000000000000000000000000000..f434163dd1778573bf73283ca02790456609f902
--- /dev/null
+++ b/runtime/vk_dlaa.c
@@ -0,0 +1,408 @@
+// DLAA: DLSS at the scene's own size, through Streamline (aod_dlss.h), Age of Decomp's own code. The replay hands
+// over, once per frame and before bloom (vk_exec_draw.c aa_hook), the HDR colour target and the depth of the frame's
+// scene draws, which carry the sub-pixel jitter of TOTK_AA_JITTER (vk_aa_jitter). DLSS writes its result into an image
+// of ours, which is then copied back over the HDR target, so bloom, tone mapping and the HUD see the anti-aliased
+// scene.
+//
+// The game has no motion vectors (its own pass writes zeros: research/dlss.md §8), so the motion vector image is zero
+// and Streamline computes camera motion from depth and clipToPrevClip. That matrix comes from the camera block of the
+// scene shaders: the vertex constants c3 of the frame's first jittered draw hold the view-projection, four float4 rows
+// for row vectors (clip = (x, y, z, 1) * VP), at row 0 in the depth prepass and row 2 in the G-buffer shaders. It is
+// recognised by its form (w is the distance along a unit forward vector, x and y are perpendicular to it, z follows
+// w), so another layout is skipped rather than misread. World coordinates reach about 5e4, so the matrices are
+// combined in double precision. The game's clip space is Streamline's: x right, y up (row 0 of an image is the top),
+// depth reversed in 0..1 (the depth test is GEQUAL); vk_dlaa_camera checks the last part per frame.
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "aod_dlss.h"
+#include "cfg.h"
+#include "host.h"
+#include "vk.h"
+#include "vk_exec.h"
+#include "platform/platform.h"
+
+typedef struct {
+    double vp[16];                       // view-projection, row vectors
+    double pos[3], right[3], up[3], fwd[3];
+    double p00, p11, a, b;               // projection: x, y scales; z_ndc = a + b / distance
+    double nearz, farz;
+    int inverted;
+} Cam;
+
+static struct {
+    int on;                              // -1 not decided yet
+    Cam cam, prev;                       // this frame's camera, and the one of the last evaluated frame
+    uint64_t cam_frame, prev_frame;      // the frames they belong to (~0: none)
+    uint32_t prev_w, prev_h;
+    VkImage out, mvec;                   // DLSS output (copied back), zero motion vectors
+    VmaAllocation out_mem, mvec_mem;
+    VkImageView out_view, mvec_view;
+    VkFormat out_fmt, in_fmt;
+    uint32_t w, h, frames;
+    int fails, cleared;
+    uint64_t evals, skipped_cam, last_log;
+} D = {.on = -1, .cam_frame = ~0ull, .prev_frame = ~0ull};
+
+// ---- matrices: row major, row vectors (p' = p * M), as Streamline wants them
+
+static void mat_mul(double r[16], const double a[16], const double b[16]) {
+    double t[16];
+    for (int i = 0; i < 4; i++)
+        for (int j = 0; j < 4; j++)
+            t[4 * i + j] = a[4 * i] * b[j] + a[4 * i + 1] * b[4 + j] + a[4 * i + 2] * b[8 + j] + a[4 * i + 3] * b[12 + j];
+    memcpy(r, t, sizeof t);
+}
+
+static int mat_inv(double r[16], const double m[16]) {   // Gauss-Jordan with partial pivoting
+    double a[4][8];
+    for (int i = 0; i < 4; i++)
+        for (int j = 0; j < 8; j++) a[i][j] = j < 4 ? m[4 * i + j] : (j - 4 == i);
+    for (int c = 0; c < 4; c++) {
+        int p = c;
+        for (int i = c + 1; i < 4; i++)
+            if (fabs(a[i][c]) > fabs(a[p][c])) p = i;
+        if (fabs(a[p][c]) < 1e-300) return 0;
+        if (p != c)
+            for (int j = 0; j < 8; j++) { double t = a[c][j]; a[c][j] = a[p][j]; a[p][j] = t; }
+        double inv = 1.0 / a[c][c];
+        for (int j = 0; j < 8; j++) a[c][j] *= inv;
+        for (int i = 0; i < 4; i++)
+            if (i != c && a[i][c] != 0) {
+                double f = a[i][c];
+                for (int j = 0; j < 8; j++) a[i][j] -= f * a[c][j];
+            }
+    }
+    for (int i = 0; i < 4; i++)
+        for (int j = 0; j < 4; j++) r[4 * i + j] = a[i][4 + j];
+    return 1;
+}
+
+static double dot3(const double *a, const double *b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; }
+
+// A perspective view-projection without jitter or skew, else 0.
+static int cam_from(const double m[16], Cam *c) {
+    double cx[3] = {m[0], m[4], m[8]}, cy[3] = {m[1], m[5], m[9]}, cz[3] = {m[2], m[6], m[10]}, f[3] = {m[3], m[7], m[11]};
+    double lf = sqrt(dot3(f, f)), p00 = sqrt(dot3(cx, cx)), p11 = sqrt(dot3(cy, cy));
+    if (!(lf > 0.98 && lf < 1.02) || !(p00 > 0.05 && p00 < 50) || !(p11 > 0.05 && p11 < 50)) return 0;
+    if (fabs(dot3(cx, f)) > 1e-2 * p00 || fabs(dot3(cy, f)) > 1e-2 * p11 || fabs(dot3(cx, cy)) > 1e-2 * p00 * p11) return 0;
+    double k = dot3(cz, f) / (lf * lf), off = 0;
+    for (int i = 0; i < 3; i++) off += (cz[i] - k * f[i]) * (cz[i] - k * f[i]);
+    if (sqrt(off) > 1e-4 + 1e-2 * fabs(k)) return 0;
+    double a = k, b = m[14] - k * m[15];   // z_clip = a * w + b with w = the distance along f
+    if (fabs(b) < 1e-9) return 0;
+    memcpy(c->vp, m, sizeof c->vp);
+    c->p00 = p00, c->p11 = p11, c->a = a, c->b = b;
+    c->inverted = b > 0;
+    if (c->inverted) c->nearz = b / (1 - a), c->farz = a < 0 ? -b / a : 1e30;
+    else c->nearz = a > 0 ? -b / a : 0, c->farz = b / (1 - a);
+    for (int i = 0; i < 3; i++) c->right[i] = cx[i] / p00, c->up[i] = cy[i] / p11, c->fwd[i] = f[i] / lf;
+    // The camera sits where clip x, y and w are all 0: three planes, solved by Cramer's rule.
+    double r0[3] = {cx[0], cx[1], cx[2]}, r1[3] = {cy[0], cy[1], cy[2]}, r2[3] = {f[0], f[1], f[2]};
+    double rhs[3] = {-m[12], -m[13], -m[15]};
+    double det = r0[0] * (r1[1] * r2[2] - r1[2] * r2[1]) - r0[1] * (r1[0] * r2[2] - r1[2] * r2[0]) +
+                 r0[2] * (r1[0] * r2[1] - r1[1] * r2[0]);
+    if (fabs(det) < 1e-12) return 0;
+    for (int col = 0; col < 3; col++) {
+        double t[3][3] = {{r0[0], r0[1], r0[2]}, {r1[0], r1[1], r1[2]}, {r2[0], r2[1], r2[2]}};
+        for (int row = 0; row < 3; row++) t[row][col] = rhs[row];
+        c->pos[col] = (t[0][0] * (t[1][1] * t[2][2] - t[1][2] * t[2][1]) - t[0][1] * (t[1][0] * t[2][2] - t[1][2] * t[2][0]) +
+                       t[0][2] * (t[1][0] * t[2][1] - t[1][1] * t[2][0])) / det;
+    }
+    return 1;
+}
+
+static int g_asked;   // TOTK_TEMPORAL was dlaa when the device was made (vk_dlaa_started)
+
+int vk_dlaa_on(void) {
+    if (D.on < 0) D.on = !strcmp(cfg_value("TOTK_TEMPORAL"), "dlaa") && aod_dlss_ready();
+    return D.on;
+}
+
+void vk_dlaa_started(int asked) { g_asked = asked; }
+
+int vk_dlaa_failed(void) { return g_asked && !vk_dlaa_on(); }
+
+int vk_dlss_dir(char *dir, size_t cap) {
+    const char *d = cfg_get("TOTK_DLSS_DIR");
+    if (d && *d) return snprintf(dir, cap, "%s", d) < (int)cap;
+    int len = cap > 16 ? plat_exe_path(dir, cap - 16) : 0;
+    char *cut = len ? plat_last_sep(dir) : NULL;
+    if (!cut) return 0;
+    strcpy(cut + 1, "streamline");
+    return 1;
+}
+
+int vk_dlss_ngx_dir(char *dir, size_t cap) {
+    char f[PLAT_PATH_MAX * 2 + 32];
+    const char *e = cfg_get("TOTK_DLSS_NGX");
+    if (e && *e) {
+        if (snprintf(dir, cap, "%s", e) >= (int)cap) return 0;
+        if (plat_file_exists(dir)) {   // the DLL itself: its folder
+            char *cut = plat_last_sep(dir);
+            if (!cut) return 0;
+            *cut = 0;
+        }
+        return 1;
+    }
+    int len = cap > 16 ? plat_exe_path(dir, cap - 16) : 0;
+    char *cut = len ? plat_last_sep(dir) : NULL;
+    if (!cut) return 0;
+    strcpy(cut + 1, "ngx");
+    snprintf(f, sizeof f, "%s/nvngx_dlss.dll", dir);
+    return plat_file_exists(f);
+}
+
+int vk_dlaa_available(void) {
+    static int known = -1;
+    VkCtx *c = vk_ctx();
+    if (!c || c->props.vendorID != 0x10de) return 0;
+    if (known < 0) {   // the folders' files decide once per run
+        char dir[PLAT_PATH_MAX * 2], ngx[PLAT_PATH_MAX * 2], f[PLAT_PATH_MAX * 2 + 32];
+        known = 0;
+        if (vk_dlss_dir(dir, sizeof dir)) {
+            snprintf(f, sizeof f, "%s/sl.interposer.dll", dir);
+            int sl = plat_file_exists(f);
+            snprintf(f, sizeof f, "%s/nvngx_dlss.dll", vk_dlss_ngx_dir(ngx, sizeof ngx) ? ngx : dir);
+            known = sl && plat_file_exists(f);
+        }
+    }
+    return known;
+}
+
+void vk_dlaa_camera(const float *rows, int nrows, uint64_t frame) {
+    if (D.cam_frame == frame) return;
+    for (int o = 0; o + 4 <= nrows && o <= 3; o++) {
+        double m[16];
+        for (int i = 0; i < 16; i++) m[i] = rows[4 * o + i];
+        Cam c;
+        if (cam_from(m, &c)) { D.cam = c, D.cam_frame = frame; return; }
+    }
+}
+
+// ---- our images
+
+typedef struct { VkImage image; VmaAllocation mem; VkImageView view; } Gone;
+
+static void free_gone(void *arg) {   // completion thread: the submissions that used them are done
+    Gone *g = arg;
+    VkCtx *c = vk_ctx();
+    if (c) {
+        if (g->view) vkDestroyImageView(c->device, g->view, NULL);
+        if (g->image) vmaDestroyImage(c->vma, g->image, g->mem);
+    }
+    free(g);
+}
+
+static void drop_images(uint64_t fence) {
+    VkImage *img[2] = {&D.out, &D.mvec};
+    VmaAllocation *mem[2] = {&D.out_mem, &D.mvec_mem};
+    VkImageView *view[2] = {&D.out_view, &D.mvec_view};
+    for (int i = 0; i < 2; i++) {
+        if (!*img[i]) continue;
+        Gone *g = calloc(1, sizeof *g);
+        if (!g) continue;
+        *g = (Gone){*img[i], *mem[i], *view[i]};
+        if (fence) vk_completion_add(fence, free_gone, g);
+        else free_gone(g);
+        *img[i] = VK_NULL_HANDLE, *mem[i] = NULL, *view[i] = VK_NULL_HANDLE;
+    }
+    D.w = D.h = 0;
+}
+
+static int make_image(VkFormat fmt, uint32_t w, uint32_t h, VkImageUsageFlags usage, VkImage *img, VmaAllocation *mem,
+                      VkImageView *view) {
+    VkCtx *c = vk_ctx();
+    VkImageCreateInfo ci = {.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO, .imageType = VK_IMAGE_TYPE_2D, .format = fmt,
+                            .extent = {w, h, 1}, .mipLevels = 1, .arrayLayers = 1, .samples = VK_SAMPLE_COUNT_1_BIT,
+                            .tiling = VK_IMAGE_TILING_OPTIMAL, .usage = usage, .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED};
+    VmaAllocationCreateInfo ai = {.usage = VMA_MEMORY_USAGE_AUTO_PREFER_DEVICE};
+    if (vmaCreateImage(c->vma, &ci, &ai, img, mem, NULL) != VK_SUCCESS) return 0;
+    VkImageViewCreateInfo vi = {.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO, .image = *img,
+                                .viewType = VK_IMAGE_VIEW_TYPE_2D, .format = fmt,
+                                .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}};
+    if (vkCreateImageView(c->device, &vi, NULL, view) != VK_SUCCESS) {
+        vmaDestroyImage(c->vma, *img, *mem);
+        *img = VK_NULL_HANDLE;
+        return 0;
+    }
+    return 1;
+}
+
+static int storage_ok(VkFormat fmt) {
+    VkFormatProperties p;
+    vkGetPhysicalDeviceFormatProperties(vk_ctx()->phys, fmt, &p);
+    return (p.optimalTilingFeatures & VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT) != 0;
+}
+
+static void full_barrier(VkCommandBuffer cb) {
+    VkMemoryBarrier2 mb = {.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_2,
+                           .srcStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, .srcAccessMask = VK_ACCESS_2_MEMORY_WRITE_BIT,
+                           .dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+                           .dstAccessMask = VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT};
+    VkDependencyInfo di = {.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO, .memoryBarrierCount = 1, .pMemoryBarriers = &mb};
+    vkCmdPipelineBarrier2(cb, &di);
+}
+
+// The output (the HDR format when the GPU can store it, else RGBA16F) and the zero motion vectors, made at the scene
+// size and taken to GENERAL in cb.
+static int ensure_images(VkExec *ex, VkCommandBuffer cb, VkFormat in_fmt, uint32_t w, uint32_t h) {
+    if (D.out && D.w == w && D.h == h && D.in_fmt == in_fmt) return 1;
+    drop_images(ex->fence);
+    VkFormat out = storage_ok(in_fmt) ? in_fmt : VK_FORMAT_R16G16B16A16_SFLOAT;
+    const VkImageUsageFlags use = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT |
+                                  VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    if (!make_image(out, w, h, use, &D.out, &D.out_mem, &D.out_view) ||
+        !make_image(VK_FORMAT_R16G16_SFLOAT, w, h, use, &D.mvec, &D.mvec_mem, &D.mvec_view)) {
+        rt_log("dlss: the DLAA images (%ux%u) could not be created", w, h);
+        drop_images(0);
+        return 0;
+    }
+    VkImageMemoryBarrier2 ib[2];
+    VkImage imgs[2] = {D.out, D.mvec};
+    for (int i = 0; i < 2; i++)
+        ib[i] = (VkImageMemoryBarrier2){.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2,
+                                        .srcStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+                                        .dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+                                        .dstAccessMask = VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT,
+                                        .oldLayout = VK_IMAGE_LAYOUT_UNDEFINED, .newLayout = VK_IMAGE_LAYOUT_GENERAL,
+                                        .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                                        .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .image = imgs[i],
+                                        .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}};
+    VkDependencyInfo di = {.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO, .imageMemoryBarrierCount = 2, .pImageMemoryBarriers = ib};
+    vkCmdPipelineBarrier2(cb, &di);
+    VkClearColorValue zero = {{0, 0, 0, 0}};
+    VkImageSubresourceRange all = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    vkCmdClearColorImage(cb, D.mvec, VK_IMAGE_LAYOUT_GENERAL, &zero, 1, &all);
+    full_barrier(cb);
+    D.w = w, D.h = h, D.out_fmt = out, D.in_fmt = in_fmt;
+    rt_log("dlss: DLAA images %ux%u, output VkFormat %d%s", w, h, (int)out, out == in_fmt ? "" : " (blit back)");
+    return 1;
+}
+
+static int too_far(const Cam *a, const Cam *b) {   // a camera cut: no history to keep
+    double d[3] = {a->pos[0] - b->pos[0], a->pos[1] - b->pos[1], a->pos[2] - b->pos[2]};
+    return dot3(d, d) > 2000.0 * 2000.0 || dot3(a->fwd, b->fwd) < 0.9 || fabs(a->p11 / b->p11 - 1) > 0.1;
+}
+
+static void release_reported(const char *why) {
+    static int n;
+    if (n++ < 8) rt_log("dlss: DLAA skipped: %s", why);
+}
+
+int vk_dlaa_run(VkExec *ex, const VkExecTarget *color, const VkExecTarget *depth, uint64_t frame, const float jitter[2],
+                int split) {
+    if (!vk_dlaa_on()) return 0;
+    if (split) return release_reported("split screen (two views per frame)"), D.prev_frame = ~0ull, 0;
+    if (!color->image || !color->img || !depth->image || !depth->img || !(depth->aspect & VK_IMAGE_ASPECT_DEPTH_BIT))
+        return release_reported("no scene colour or depth"), 0;
+    if (color->width != depth->width || color->height != depth->height || color->samples > 1)
+        return release_reported("colour and depth differ"), 0;
+    if (!(color->img->usage & VK_IMAGE_USAGE_SAMPLED_BIT) || !(color->img->usage & VK_IMAGE_USAGE_TRANSFER_DST_BIT) ||
+        !(depth->img->usage & VK_IMAGE_USAGE_SAMPLED_BIT))
+        return release_reported("the scene images lack sampled or transfer usage"), 0;
+    if (D.cam_frame != frame) {   // no camera recognised this frame: leave the frame as it is
+        if (++D.skipped_cam == 1 || D.skipped_cam % 600 == 0)
+            rt_log("dlss: frame %llu: no camera in the scene constants, DLAA skipped (%llu frames so far)",
+                   (unsigned long long)frame, (unsigned long long)D.skipped_cam);
+        D.prev_frame = ~0ull;
+        return 0;
+    }
+    uint32_t w = color->width, h = color->height;
+    int was_open = ex->in_pass;
+    vk_exec_barrier(ex);   // ends the pass; the scene's draws are complete and visible
+    VkCommandBuffer cb = ex->cb;
+    if (!ensure_images(ex, cb, color->format, w, h)) {
+        D.on = 0;
+        if (was_open) vk_exec_pass_begin(ex);
+        return 1;
+    }
+
+    AodDlssFrame f;
+    memset(&f, 0, sizeof f);
+    const Cam *c = &D.cam;
+    int reset = D.prev_frame == ~0ull || D.prev_frame + 1 != frame || D.prev_w != w || D.prev_h != h ||
+                too_far(c, &D.prev);
+    const Cam *p = reset ? c : &D.prev;
+    double inv[16];
+    if (!mat_inv(inv, c->vp)) {
+        if (was_open) vk_exec_pass_begin(ex);
+        return 1;
+    }
+    mat_mul(f.clip_to_prev, inv, p->vp);   // clip -> world -> previous clip
+    if (!mat_inv(f.prev_to_clip, f.clip_to_prev)) memcpy(f.prev_to_clip, f.clip_to_prev, sizeof f.prev_to_clip);
+    double proj[16] = {c->p00, 0, 0, 0, 0, c->p11, 0, 0, 0, 0, c->a, 1, 0, 0, c->b, 0};   // view: x right, y up, z ahead
+    memcpy(f.view_to_clip, proj, sizeof proj);
+    if (!mat_inv(f.clip_to_view, proj)) memcpy(f.clip_to_view, proj, sizeof proj);
+    memcpy(f.cam_pos, c->pos, sizeof f.cam_pos);
+    memcpy(f.cam_up, c->up, sizeof f.cam_up);
+    memcpy(f.cam_right, c->right, sizeof f.cam_right);
+    memcpy(f.cam_fwd, c->fwd, sizeof f.cam_fwd);
+    f.cam_near = c->nearz, f.cam_far = c->farz;
+    f.cam_fov = 2 * atan(1 / c->p11), f.cam_aspect = c->p11 / c->p00;
+    static double sign = 0;
+    if (!sign) {   // developer switch while the convention is checked: TOTK_DLAA_JITTER_SIGN=-1 flips the offset
+        const char *e = cfg_get("TOTK_DLAA_JITTER_SIGN");
+        sign = e && atof(e) < 0 ? -1 : 1;
+    }
+    f.jitter[0] = (float)(sign * jitter[0]), f.jitter[1] = (float)(sign * jitter[1]);
+    f.reset = reset;
+    f.depth_inverted = c->inverted;
+    f.frame = ++D.frames;
+    f.color_in = (AodDlssImage){color->image,
+                                vk_exec_target_view(color->img, color->format, VK_IMAGE_VIEW_TYPE_2D, VK_IMAGE_ASPECT_COLOR_BIT,
+                                                    color->level, color->base_layer, 1, 0),
+                                color->format, w, h, color->img->usage & ~VK_IMAGE_USAGE_STORAGE_BIT, VK_IMAGE_ASPECT_COLOR_BIT};
+    f.depth = (AodDlssImage){depth->image,
+                             vk_exec_target_view(depth->img, depth->format, VK_IMAGE_VIEW_TYPE_2D, VK_IMAGE_ASPECT_DEPTH_BIT,
+                                                 depth->level, depth->base_layer, 1, 0),
+                             depth->format, w, h, depth->img->usage & ~VK_IMAGE_USAGE_STORAGE_BIT, VK_IMAGE_ASPECT_DEPTH_BIT};
+    const VkImageUsageFlags use = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT |
+                                  VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    f.color_out = (AodDlssImage){D.out, D.out_view, D.out_fmt, w, h, use, VK_IMAGE_ASPECT_COLOR_BIT};
+    f.mvec = (AodDlssImage){D.mvec, D.mvec_view, VK_FORMAT_R16G16_SFLOAT, w, h, use, VK_IMAGE_ASPECT_COLOR_BIT};
+
+    // Streamline records into cb itself, on this thread: the recorder (vk_rec.h) must first have made every call queued
+    // so far, and the calls queued after this one follow Streamline's.
+    rec_drain();
+    int ok = aod_dlss_evaluate(cb, &f);
+    if (ok) {
+        full_barrier(cb);
+        if (D.out_fmt == color->format) {
+            VkImageCopy rc = {.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+                              .dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, color->level, color->base_layer, 1},
+                              .extent = {w, h, 1}};
+            vkCmdCopyImage(cb, D.out, VK_IMAGE_LAYOUT_GENERAL, color->image, VK_IMAGE_LAYOUT_GENERAL, 1, &rc);
+        } else {
+            VkImageBlit rb = {.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+                              .srcOffsets = {{0, 0, 0}, {(int32_t)w, (int32_t)h, 1}},
+                              .dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, color->level, color->base_layer, 1},
+                              .dstOffsets = {{0, 0, 0}, {(int32_t)w, (int32_t)h, 1}}};
+            vkCmdBlitImage(cb, D.out, VK_IMAGE_LAYOUT_GENERAL, color->image, VK_IMAGE_LAYOUT_GENERAL, 1, &rb, VK_FILTER_NEAREST);
+        }
+        D.evals++;
+        D.fails = 0;
+        D.prev = *c, D.prev_frame = frame, D.prev_w = w, D.prev_h = h;
+    } else {
+        D.prev_frame = ~0ull;
+        if (++D.fails >= 120) {   // two seconds without a single evaluation: stop, and with it the jitter
+            rt_log("dlss: DLAA off: Streamline kept failing (see above)");
+            D.on = 0;
+        }
+    }
+    ex->recorded += 4;   // the barriers below see the commands recorded here
+    if (D.evals && D.evals - D.last_log >= 600) {
+        D.last_log = D.evals;
+        rt_log("dlss: DLAA frames %llu (frame %llu, reset %d, camera %.0f %.0f %.0f, near %.1f, %s Z, jitter %.3f %.3f, "
+               "frames without a camera %llu)", (unsigned long long)D.evals, (unsigned long long)frame, reset, c->pos[0],
+               c->pos[1], c->pos[2], c->nearz, c->inverted ? "reversed" : "standard", f.jitter[0], f.jitter[1],
+               (unsigned long long)D.skipped_cam);
+    }
+    if (was_open) vk_exec_pass_begin(ex);   // a full barrier first: the copy is visible to the pass
+    else vk_exec_barrier(ex);
+    return 1;
+}
+
+void vk_dlaa_release(void) { drop_images(0); }
