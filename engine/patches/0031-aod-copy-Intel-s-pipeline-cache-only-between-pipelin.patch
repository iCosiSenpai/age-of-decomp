From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Age of Decomp patch queue <aod-patches@localhost>
Date: Fri, 20 Nov 2026 14:11:37 +0100
Subject: [PATCH] aod: copy Intel's pipeline cache only between pipeline builds

On Intel's Windows driver (igvk64 101.9175, Xe iGPU device 0x7d67) every boot ended two seconds in with an access
violation inside the driver and no line in the log: the first autosave's vkGetPipelineCacheData read through a null
pointer while worker threads were building pipelines into the same cache. Vulkan lets a pipeline cache be used from
several threads, and other drivers do that fine, so only there the copy now takes a lock exclusively that every
build into P.cache takes shared; elsewhere nothing waits.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runtime/vk.h          |  1 +
 runtime/vk_caps.c     |  2 ++
 runtime/vk_pipeline.c | 24 ++++++++++++++++++++----
 3 files changed, 23 insertions(+), 4 deletions(-)

diff --git a/runtime/vk.h b/runtime/vk.h
index 6b8d18eb05b1fa9294b3df081878dea68b6874fc..5c98ad1e6dcec7e2795b15a70b88146c37116849 100644
--- a/runtime/vk.h
+++ b/runtime/vk.h
@@ -56,6 +56,7 @@ typedef struct {
     int amd;                           // an AMD GPU (vendor 0x1002), any driver
     int amd_sc;                        // AMD's Windows driver branch for RDNA 1 and 2 ("AMD proprietary shader compiler")
     int amd_rdna3;                     // a discrete RDNA 3 GPU (Navi 31/32/33, device 0x7440-0x749f) on AMD's own driver
+    int intel_win;                     // Intel's Windows driver (igvk64): the pipeline cache copy waits for builds
 } VkCaps;
 extern VkCaps vk_caps;
 void vk_caps_driver(VkPhysicalDevice p);             // first, before vkCreateDevice: vk_caps.amd, amd_sc
diff --git a/runtime/vk_caps.c b/runtime/vk_caps.c
index 920f777c298b93ba2a8a57ba6867867a4ffa592d..192ed14d2a951b906675032fd476895afa6c19cd 100644
--- a/runtime/vk_caps.c
+++ b/runtime/vk_caps.c
@@ -48,6 +48,8 @@ void vk_caps_driver(VkPhysicalDevice p) {
     uint32_t id = p2.properties.deviceID;
     vk_caps.amd_rdna3 = vk_caps.amd && !vk_caps.amd_sc && drv.driverID == VK_DRIVER_ID_AMD_PROPRIETARY &&
                         id >= 0x7440 && id <= 0x749f;
+    // Its vkGetPipelineCacheData faults while another thread builds a pipeline into the same cache (vk_pipeline.c).
+    vk_caps.intel_win = drv.driverID == VK_DRIVER_ID_INTEL_PROPRIETARY_WINDOWS;
 }
 
 // TOTK_GPL=0/1 forces graphics pipeline libraries off or on. Default off on AMD's RDNA 1/2 driver branch: every boot
diff --git a/runtime/vk_pipeline.c b/runtime/vk_pipeline.c
index a0073b8eb4f388182fcbc975b366ae2892ee075e..3677b57472fe5a39653edf7f2b95f6e9ae4455d9 100644
--- a/runtime/vk_pipeline.c
+++ b/runtime/vk_pipeline.c
@@ -165,6 +165,14 @@ static void cache_path_init(void) {
     snprintf(P.cache_path, sizeof P.cache_path, "%s/pipeline-cache.bin", exe);
 }
 
+// Intel's Windows driver faults in vkGetPipelineCacheData while another thread builds a pipeline into the same cache
+// (igvk64 101.9175 on an Xe iGPU, device 0x7d67: a read at 0x190 on the first autosave, two seconds into every boot).
+// There the copy takes cache_rw exclusively and every build that uses P.cache takes it shared; other drivers
+// synchronise P.cache themselves, as Vulkan asks, and take no lock.
+static PlatMutex cache_rw = PLAT_MUTEX_INIT;
+static void cache_build_begin(void) { if (vk_caps.intel_win) plat_mutex_lock_shared(&cache_rw); }
+static void cache_build_end(void) { if (vk_caps.intel_win) plat_mutex_unlock_shared(&cache_rw); }
+
 // Cache data whose header names another device or driver is dropped before Vulkan sees it.
 static void cache_load(VkCtx *c) {
     cache_path_init();
@@ -194,6 +202,7 @@ static void cache_load(VkCtx *c) {
         if (vkCreatePipelineCache(c->device, &ci, NULL, &P.cache) != VK_SUCCESS) P.cache = VK_NULL_HANDLE;
     }
     free(data);
+    if (vk_caps.intel_win) rt_log("vk_pipeline: Intel driver: the cache is copied only between pipeline builds");
 }
 
 static void keys_open(void);
@@ -2002,7 +2011,9 @@ static VkPipeline create_graphics(const VkPipeState *s, const GKey *k, const Lay
     if (k->fbl & 1) pi.flags |= VK_PIPELINE_CREATE_COLOR_ATTACHMENT_FEEDBACK_LOOP_BIT_EXT;
     if (k->fbl & 2) pi.flags |= VK_PIPELINE_CREATE_DEPTH_STENCIL_ATTACHMENT_FEEDBACK_LOOP_BIT_EXT;
     uint64_t p0 = perf_begin();
+    cache_build_begin();
     VkResult r = vkCreateGraphicsPipelines(P.device, P.cache, 1, &pi, NULL, &pipe);
+    cache_build_end();
     perf_end(PERF_PIPE, p0);   // counts on the render thread only, so background builds stay out of it
     if (r != VK_SUCCESS) {
         rt_log("vk_pipeline: vkCreateGraphicsPipelines failed (%d)", (int)r);
@@ -2154,7 +2165,9 @@ static VkPipeline lib_create(int kind, const VkPipeState *s, const GKey *k, VkPi
         ri.depthAttachmentFormat = (VkFormat)k->depth, ri.stencilAttachmentFormat = (VkFormat)k->stencil;
         pi.pColorBlendState = &cb, pi.pMultisampleState = &ms;
     }
+    cache_build_begin();
     if (vkCreateGraphicsPipelines(P.device, P.cache, 1, &pi, NULL, &pipe) != VK_SUCCESS) pipe = VK_NULL_HANDLE;
+    cache_build_end();
 out:
     if (m) vkDestroyShaderModule(P.device, m, NULL);
     free(patched);
@@ -3094,7 +3107,9 @@ static VkPipeline compute_create(const GfxShader *cs, const Layout *l) {
                                       .layout = l->layout};
     pin_subgroup32(&ci.stage, &rqc, code, words);
     VkPipeline pipe = VK_NULL_HANDLE;
+    cache_build_begin();
     if (vkCreateComputePipelines(P.device, P.cache, 1, &ci, NULL, &pipe) != VK_SUCCESS) pipe = VK_NULL_HANDLE;
+    cache_build_end();
     vkDestroyShaderModule(P.device, m, NULL);
     return pipe;
 }
@@ -3809,10 +3824,11 @@ void vk_pipeline_save(void) {
     }
     size_t size = 0;
     void *data = NULL;
-    if (vkGetPipelineCacheData(P.device, P.cache, &size, NULL) == VK_SUCCESS && size && (data = malloc(size)) &&
-        vkGetPipelineCacheData(P.device, P.cache, &size, data) == VK_SUCCESS) {
-        if (!plat_file_write_atomic(P.cache_path, data, size)) rt_log("vk_pipeline: cannot write %s", P.cache_path);
-    }
+    if (vk_caps.intel_win) plat_mutex_lock(&cache_rw);   // between builds there (cache_build_begin)
+    int got = vkGetPipelineCacheData(P.device, P.cache, &size, NULL) == VK_SUCCESS && size && (data = malloc(size)) &&
+              vkGetPipelineCacheData(P.device, P.cache, &size, data) == VK_SUCCESS;
+    if (vk_caps.intel_win) plat_mutex_unlock(&cache_rw);
+    if (got && !plat_file_write_atomic(P.cache_path, data, size)) rt_log("vk_pipeline: cannot write %s", P.cache_path);
     free(data);
     plat_mutex_unlock(&save_lock);
 }
