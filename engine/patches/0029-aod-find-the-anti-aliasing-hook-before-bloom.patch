From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: iCosiSenpai <aod-patches@localhost>
Date: Thu, 19 Nov 2026 18:55:14 +0100
Subject: [PATCH] aod: find the anti-aliasing hook before bloom

DLAA and FSR have to see the finished HDR scene before bloom and tone mapping. The first pass that reads it is the
bloom prefilter, whose fragment shader has the same NVN 2 origin in every capture of this game version, at native scale
and with jitter. With TOTK_AA_JITTER=1 the replay now remembers the colour target and the depth of the frame's last
jittered draw, which the transparents and the half-resolution composite also write, and recognises that pass once per
frame. For now it reports what it found; the evaluation comes with the anti-aliasing backend.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runtime/vk_exec_draw.c | 38 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 38 insertions(+)

diff --git a/runtime/vk_exec_draw.c b/runtime/vk_exec_draw.c
index fcb7a3c5e84da908511182c6bd702648c0b36d2f..b4ea9257fb9d9ac8372f4cadb06d84ba787e0697 100644
--- a/runtime/vk_exec_draw.c
+++ b/runtime/vk_exec_draw.c
@@ -2859,6 +2859,42 @@ static uint8_t aa_jitter_draw(const VkExec *ex, const VkPipeState *s, uint32_t c
     return 1;
 }
 
+// ---- the anti-aliasing hook: the first pass that reads the finished HDR scene, the bloom prefilter (a fragment
+// shader of NVN 2 origin 0df22c8c09b94a72 in HWAoI 196608, the same at native scale and with jitter). DLAA / FSR run
+// there on the HDR colour target and the depth of the frame's last jittered draw (passes 40-57 and the half-res
+// composite share that target). For now the hook only reports what it found (G-2c); the evaluation comes next.
+#define AA_HOOK_ORIGIN 0x0df22c8c09b94a72ull
+static VkExecTarget aa_color, aa_depth;        // targets of the frame's last jittered draw
+static uint64_t aa_color_frame = ~0ull, aa_hook_frame = ~0ull, aa_hooks;
+static const void *aa_prog;                    // the last program looked at, its serial and the answer
+static uint64_t aa_prog_serial;
+static int aa_prog_hook;
+
+static int prog_is_hook(const VkExec *ex) {
+    if (!ex->prog) return 0;
+    if ((const void *)ex->prog == aa_prog && ex->prog->serial == aa_prog_serial) return aa_prog_hook;
+    aa_prog = ex->prog, aa_prog_serial = ex->prog->serial, aa_prog_hook = 0;
+    for (uint32_t k = 0; k < ex->prog->nstage && k < 6; k++) {
+        const uint8_t *control = ex->prog->sd[k].control;
+        const uint8_t *code = nvn_program_source((const uint8_t *)(uintptr_t)ex->prog->sd[k].data);
+        uint64_t o = control && gfx_shader_is_nvn2(control) ? gfx_shader_nvn2_hash(control, code) : nvn2_origin(code);
+        if (o == AA_HOOK_ORIGIN) aa_prog_hook = 1;
+    }
+    return aa_prog_hook;
+}
+
+static void aa_hook(VkExec *ex) {
+    if (aa_hook_frame == aa_frame || !prog_is_hook(ex)) return;
+    aa_hook_frame = aa_frame;
+    aa_hooks++;
+    int found = aa_color_frame == aa_frame && aa_color.image && aa_depth.image;
+    if (aa_hooks == 1 || aa_hooks % 600 == 0)
+        rt_log(found ? "aa: hook %llu at frame %llu: HDR colour %ux%u (VkFormat %d), depth %ux%u (VkFormat %d)"
+                     : "aa: hook %llu at frame %llu: no jittered HDR target this frame",
+               (unsigned long long)aa_hooks, (unsigned long long)aa_frame, aa_color.width, aa_color.height,
+               (int)aa_color.format, aa_depth.width, aa_depth.height, (int)aa_depth.format);
+}
+
 static void record_fixed(VkExec *ex) {
     VkCommandBuffer cb = ex->cb;
     if (ex->dirty & VK_EXEC_DIRTY_VIEWPORT) {
@@ -3337,6 +3373,8 @@ static int prepare_draw(VkExec *ex, int prim, int32_t count, int restart) {
     }
     ex->aa_jit = aa_jitter_draw(ex, &s, count, &sc);
     if (ex->aa_jit != ex->aa_jit_rec) ex->dirty |= VK_EXEC_DIRTY_VIEWPORT;   // jittered and plain draws share a pass
+    if (ex->aa_jit) aa_color = ex->color[0], aa_depth = ex->depth, aa_color_frame = aa_frame;
+    else if (aa_mode > 0) aa_hook(ex);
     record_fixed(ex);
     repeat_stats(ex, info);
     bind_resources(ex, info);
