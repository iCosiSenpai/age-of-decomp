+open
+frames 2
+set OUTPUT_RES=2560x1440
+frames 2
+expect-status 2
+shot restart-unavailable
+""" + "key DownArrow tap\n" * 30 + """
+key Enter tap
+expect-restart 0
+expect-quit 1
+""", {"AOD_RESTART_EXIT": ""}, 1920, 1080, "en"
