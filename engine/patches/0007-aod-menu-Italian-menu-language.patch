+        conversions("%s %d") == conversions("%d %s") ||
+        conversions("% s") != std::vector<std::string>{"% s"} ||
+        conversions("%2$s") != std::vector<std::string>{"%2$s"})
+        throw std::runtime_error("text: printf parser self-check failed");
