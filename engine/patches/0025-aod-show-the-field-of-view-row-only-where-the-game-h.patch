From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: iCosiSenpai <aod-patches@localhost>
Date: Thu, 19 Nov 2026 17:29:42 +0100
Subject: [PATCH] aod: show the field of view row only where the game has its
 patch

The field of view is a patch set of the generated patches for a game version (res_fov_live). This game version has
none, so the Screen page's slider changed nothing; the row now shows only when the set exists. The menu preview has no
patch sets and hides it too.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runtime/ui/menu.cpp          | 4 +++-
 tests/menu_preview_stubs.cpp | 2 ++
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/runtime/ui/menu.cpp b/runtime/ui/menu.cpp
index 86fd31cc81aa35dc784f3306ca79958ae733f1d1..c5411a2a406321f4f267b1e75046ea2eee3c1822 100644
--- a/runtime/ui/menu.cpp
+++ b/runtime/ui/menu.cpp
@@ -52,6 +52,7 @@ void rt_log(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
 void vk_queue_lock(void);
 void vk_queue_unlock(void);
 void res_sizes(unsigned out[2], unsigned scene[2]);
+int rt_patch_set(const char *name);
 double frame_step_limit_hz(void);
 extern const int rt_game_version;
 // fs.h (romfs.c): romfs-patches-xbox was next to romfs-index.bin at start, and was loaded.
@@ -719,7 +720,8 @@ static void tab_screen(float scale) {
     opt_slider("TOTK_SHARPNESS", UI_MENU_SHARPNESS, 0, 100, UI_MENU_SHARPNESS_DESC, 5, "%.0f %%");
     static const UiTextId aspect[] = {UI_MENU_ASPECT_FIT, UI_MENU_ASPECT_STRETCH};
     opt_choice("TOTK_ASPECT", UI_MENU_ASPECT, aspect, 2, UI_MENU_ASPECT_DESC);
-    opt_slider("TOTK_FOV", UI_MENU_FOV, 70, 140, UI_MENU_FOV_DESC, 5, "%.0f %%");
+    // Only where this game version has the field-of-view patch (res_fov_live); without it the row would do nothing.
+    if (rt_patch_set("fov") >= 0) opt_slider("TOTK_FOV", UI_MENU_FOV, 70, 140, UI_MENU_FOV_DESC, 5, "%.0f %%");
     rows_color();
     opt_end();
 }
diff --git a/tests/menu_preview_stubs.cpp b/tests/menu_preview_stubs.cpp
index 32ab75c71aa6fe9418cc8d0f52cd085000184a00..b53c4dfe8793579e7892ecd598650db7568c73e2 100644
--- a/tests/menu_preview_stubs.cpp
+++ b/tests/menu_preview_stubs.cpp
@@ -54,6 +54,8 @@ void gfx_window_request_close(void) { preview_quit = true; }
 // The Restart button shows only when the launcher restarts the game (AOD_RESTART_EXIT), as gfx_present.c.
 int gfx_restart_available(void) { const char *v = getenv("AOD_RESTART_EXIT"); return v && atoi(v) > 0 && atoi(v) < 255; }
 void gfx_request_restart(void) { if (gfx_restart_available()) preview_restart = preview_quit = true; }
+// No generated patch sets in the preview: rows of game-version patches (field of view) are hidden.
+int rt_patch_set(const char *) { return -1; }
 int gfx_window_monitor_size(int *w, int *h) { *w = 2560; *h = 1440; return 1; }
 double gfx_window_refresh_hz(void) { return 60; }
 unsigned gfx_window_dpi(void) { return preview_dpi; }
