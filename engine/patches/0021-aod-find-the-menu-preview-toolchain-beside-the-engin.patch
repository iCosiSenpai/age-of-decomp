From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Age of Decomp patch queue <aod-patches@localhost>
Date: Thu, 19 Nov 2026 12:18:26 +0100
Subject: [PATCH] aod: find the menu preview toolchain beside the engine
 checkout

The menu preview test no longer names one maintainer's folder. It uses
AOD_TOOLCHAIN_DIR, else the project toolchain next to the engine checkout;
--cc and --deps still choose any other compiler and libraries.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/menu_preview_test.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tests/menu_preview_test.py b/tests/menu_preview_test.py
index 628f34de4d8f8626a05ae8cf47e7b16c2967f4ac..0bfd5a79314ee04be00a22566a0ba72030b6d13d 100644
--- a/tests/menu_preview_test.py
+++ b/tests/menu_preview_test.py
@@ -11,7 +11,9 @@ import sys
 import tempfile
 
 ROOT = Path(__file__).resolve().parents[1]
-TOOLCHAIN = Path(r"F:\dev\age-of-decomp\.cache\toolchain\windows")
+# The Age of Decomp toolchain: AOD_TOOLCHAIN_DIR, else the one beside this engine checkout
+# (<project>/.cache/engine/hwaoi-recomp -> <project>/.cache/toolchain/windows). --cc and --deps pick any other.
+TOOLCHAIN = Path(os.environ.get("AOD_TOOLCHAIN_DIR") or ROOT.parent.parent / "toolchain" / "windows")
 DEFAULT_CC = TOOLCHAIN / "llvm/bin/clang++.exe"
 DEFAULT_DEPS = TOOLCHAIN / "deps" if os.name == "nt" else Path("/usr")
 
