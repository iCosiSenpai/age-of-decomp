From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Age of Decomp patch queue <aod-patches@localhost>
Date: Fri, 20 Nov 2026 14:19:57 +0100
Subject: [PATCH] aod: report crashes outside the game's code

The crash reporter took only faults in the executable: a fault in a GPU driver, the C runtime or SDL was left to the
handlers of that code, and when none took it the process ended with its exception code and no line in the log, as
Intel's Vulkan driver did on its first pipeline cache copy. A top-level exception filter, which Windows calls only for
an exception nothing handled, now reports it the same way: FATAL with the module and the offset in it, the thread's
name and the frames of the executable that led there, unwound from the fault's context, then exit code 71.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runtime/main.c              | 12 ++++--
 runtime/platform/platform.h |  5 +++
 runtime/platform/win32.c    | 77 ++++++++++++++++++++++++++++++++++---
 3 files changed, 84 insertions(+), 10 deletions(-)

diff --git a/runtime/main.c b/runtime/main.c
index dd04e4ffc9c51c6dd349759bb84315d35001d20d..4db284c66ce6166e1b97e114521ae9e39a24f37b 100644
--- a/runtime/main.c
+++ b/runtime/main.c
@@ -404,16 +404,20 @@ static void crash_handler(const PlatCrash *x) {
     if (plat_xchg32(&busy, 1)) plat_exit(71);
     char d[160];
     uintptr_t rip = x->rip;
-    rt_logf("FATAL: %s (%#x) at host %p (totk+%#llx)", x->what, x->code, (void *)rip, (unsigned long long)x->offset);
+    rt_logf("FATAL: %s (%#x) at host %p (%s+%#llx)", x->what, x->code, (void *)rip, x->module ? x->module : "totk",
+            (unsigned long long)x->offset);
     if (x->access >= 0)
         rt_logf(", %s address %#llx", x->access == 1 ? "writing" : x->access == 8 ? "executing" : "reading",
                 (unsigned long long)x->addr);
+    if (x->thread) rt_logf(", thread '%s'", x->thread);
     rt_log_raw("\n", 1);
-    uint64_t f = lifted_function(rip);
+    if (x->module) rt_logf("  outside the game's code: in %s, called from the frames below\n", x->module);
+    uint64_t f = x->module ? 0 : lifted_function(rip);
     if (f) rt_logf("  in lifted function f_%llx = %s\n", (unsigned long long)f, ldr_describe(f, d, sizeof d));
-    for (int i = 0; i < x->nframes; i++) {   // abort and invalid parameter: where the host code called it
+    uintptr_t base = x->base ? x->base : rip - x->offset;
+    for (int i = 0; i < x->nframes; i++) {   // abort, invalid parameter, a fault outside: the host code's frames
         uint64_t g = lifted_function(x->frames[i]);
-        rt_logf("  host frame %2d: totk+%#llx", i, (unsigned long long)(x->frames[i] - (rip - x->offset)));
+        rt_logf("  host frame %2d: totk+%#llx", i, (unsigned long long)(x->frames[i] - base));
         if (g) rt_logf(" in lifted function f_%llx", (unsigned long long)g);
         rt_log_raw("\n", 1);
     }
diff --git a/runtime/platform/platform.h b/runtime/platform/platform.h
index 023139afd80ebcc8673c23597983df74445556a2..6837b827e82634aee21bf9364c2ade80943c2c30 100644
--- a/runtime/platform/platform.h
+++ b/runtime/platform/platform.h
@@ -221,6 +221,11 @@ typedef struct {
     uint64_t addr;             // its address when access >= 0
     int nframes;               // abort and invalid parameter: return addresses in this executable, innermost first
     uintptr_t frames[16];      // (rip is frames[0]); 0 for a fault, whose rip is exact
+    // A fault outside this executable (Windows: an unhandled one in a driver or a library): the module's file name and
+    // offset holds the offset in it, frames the callers in this executable, base this executable's load address.
+    const char *module;        // NULL: this executable
+    const char *thread;        // the faulting thread's name, NULL when it has none or it is not known
+    uintptr_t base;            // 0: rip - offset
 } PlatCrash;
 void plat_crash_hook(void (*fn)(const PlatCrash *c));
 int plat_mem_read(uint64_t addr, void *out, size_t n);    // copies n bytes, 0 instead of faulting on unmapped memory
diff --git a/runtime/platform/win32.c b/runtime/platform/win32.c
index efc3c8b90b81136853c0577bc9d399d604103fe9..2e17f5dbe11a4fe9f7ff81fb9f49b19bc69a9e2b 100644
--- a/runtime/platform/win32.c
+++ b/runtime/platform/win32.c
@@ -587,14 +587,18 @@ void plat_mem_fault_hook(int (*fn)(uint64_t addr)) {
 
 static void (*crash_fn)(const PlatCrash *c);
 
+static const char *crash_what(DWORD code) {
+    return code == EXCEPTION_ACCESS_VIOLATION ? "access violation"
+         : code == EXCEPTION_ILLEGAL_INSTRUCTION ? "illegal instruction"
+         : code == EXCEPTION_INT_DIVIDE_BY_ZERO ? "integer division by zero"
+         : code == EXCEPTION_PRIV_INSTRUCTION ? "privileged instruction"
+         : code == EXCEPTION_STACK_OVERFLOW ? "stack overflow"
+         : code == EXCEPTION_IN_PAGE_ERROR ? "in-page error" : NULL;
+}
+
 static LONG CALLBACK crash_veh(EXCEPTION_POINTERS *ep) {
     DWORD code = ep->ExceptionRecord->ExceptionCode;
-    const char *what = code == EXCEPTION_ACCESS_VIOLATION ? "access violation"
-                     : code == EXCEPTION_ILLEGAL_INSTRUCTION ? "illegal instruction"
-                     : code == EXCEPTION_INT_DIVIDE_BY_ZERO ? "integer division by zero"
-                     : code == EXCEPTION_PRIV_INSTRUCTION ? "privileged instruction"
-                     : code == EXCEPTION_STACK_OVERFLOW ? "stack overflow"
-                     : code == EXCEPTION_IN_PAGE_ERROR ? "in-page error" : NULL;
+    const char *what = crash_what(code);
     if (!what) return EXCEPTION_CONTINUE_SEARCH;
     uintptr_t rip = (uintptr_t)ep->ContextRecord->Rip;
     MODULEINFO mi;
@@ -608,6 +612,66 @@ static LONG CALLBACK crash_veh(EXCEPTION_POINTERS *ep) {
     return EXCEPTION_CONTINUE_SEARCH;
 }
 
+// A fault outside this executable (a GPU driver, the C runtime, SDL) that no handler of that code takes would end the
+// process with its exception code and no line in the log, as Intel's Vulkan driver did on its first pipeline cache
+// copy. The top-level filter, called only for such an unhandled exception, reports it like the faults above, naming
+// the module, the thread and the frames of this executable that led there (unwound from the fault's context).
+static LPTOP_LEVEL_EXCEPTION_FILTER crash_prev_filter;
+
+static LONG WINAPI crash_unhandled(EXCEPTION_POINTERS *ep) {
+    DWORD code = ep->ExceptionRecord->ExceptionCode;
+    const char *what = crash_what(code);
+    MODULEINFO mi;
+    if (!what || !crash_fn || !GetModuleInformation(GetCurrentProcess(), GetModuleHandleW(NULL), &mi, sizeof mi))
+        return crash_prev_filter ? crash_prev_filter(ep) : EXCEPTION_CONTINUE_SEARCH;
+    uintptr_t rip = (uintptr_t)ep->ContextRecord->Rip, base = (uintptr_t)mi.lpBaseOfDll;
+    PlatCrash c = {what, (uint32_t)code, rip, rip - base, -1, 0};
+    c.base = base;
+    if (code == EXCEPTION_ACCESS_VIOLATION && ep->ExceptionRecord->NumberParameters >= 2)
+        c.access = (int)ep->ExceptionRecord->ExceptionInformation[0], c.addr = ep->ExceptionRecord->ExceptionInformation[1];
+    static char module[MAX_PATH * 3], thread[192];
+    HMODULE m = NULL;
+    if (rip - base >= mi.SizeOfImage) {
+        snprintf(module, sizeof module, "an unknown module");
+        wchar_t w[MAX_PATH];
+        DWORD n;
+        if (GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                               (LPCWSTR)rip, &m) && (n = GetModuleFileNameW(m, w, MAX_PATH)) && n < MAX_PATH) {
+            const wchar_t *leaf = w;
+            for (const wchar_t *p = w; *p; p++)
+                if (*p == L'\\' || *p == L'/') leaf = p + 1;
+            if (!WideCharToMultiByte(CP_UTF8, 0, leaf, -1, module, sizeof module, NULL, NULL))
+                snprintf(module, sizeof module, "an unknown module");
+            c.offset = rip - (uintptr_t)m;
+        }
+        c.module = module;
+    }
+    PWSTR desc = NULL;
+    if (SUCCEEDED(GetThreadDescription(GetCurrentThread(), &desc)) && desc && *desc &&
+        WideCharToMultiByte(CP_UTF8, 0, desc, -1, thread, sizeof thread, NULL, NULL))
+        c.thread = thread;
+    if (desc) LocalFree(desc);
+    // The frames in this executable, innermost first: unwound from the fault's context, which a leaf function (no
+    // unwind data) leaves with its return address at rsp.
+    CONTEXT ctx = *ep->ContextRecord;
+    for (int depth = 0; depth < 96 && ctx.Rip && c.nframes < (int)(sizeof c.frames / sizeof *c.frames); depth++) {
+        if (ctx.Rip - base < mi.SizeOfImage && ctx.Rip != rip) c.frames[c.nframes++] = ctx.Rip;
+        DWORD64 image = 0;
+        PRUNTIME_FUNCTION fe = RtlLookupFunctionEntry(ctx.Rip, &image, NULL);
+        if (fe) {
+            void *handler_data;
+            DWORD64 frame;
+            RtlVirtualUnwind(UNW_FLAG_NHANDLER, image, ctx.Rip, fe, &ctx, &handler_data, &frame, NULL);
+        } else if (plat_mem_readable(ctx.Rsp, 8)) {
+            ctx.Rip = *(const DWORD64 *)(uintptr_t)ctx.Rsp, ctx.Rsp += 8;
+        } else {
+            break;
+        }
+    }
+    crash_fn(&c);   // ends the process (71)
+    return EXCEPTION_CONTINUE_SEARCH;
+}
+
 // abort() and an invalid parameter to a C runtime function raise no exception: the C runtime ends the process with
 // 0xc0000409 after calling the SIGABRT or invalid-parameter handler. The report names the host frames in this
 // executable; the innermost is the caller of abort (assert) or of the C runtime function. Skipped frames: this function
@@ -637,6 +701,7 @@ static void invalid_parameter(const wchar_t *expr, const wchar_t *func, const wc
 void plat_crash_hook(void (*fn)(const PlatCrash *c)) {
     crash_fn = fn;
     AddVectoredExceptionHandler(0, crash_veh);
+    crash_prev_filter = SetUnhandledExceptionFilter(crash_unhandled);
     signal(SIGABRT, abort_signal);
     _set_invalid_parameter_handler(invalid_parameter);
 }
