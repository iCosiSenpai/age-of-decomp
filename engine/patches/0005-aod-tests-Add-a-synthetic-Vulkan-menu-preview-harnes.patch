+++ b/tests/menu_preview_stubs.cpp
@@ -0,0 +1,100 @@
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+extern "C" {
+#include "cfg.h"
+#include "input.h"
+#include "input_map.h"
+#include "perfmon.h"
+#include "sysinfo.h"
+#include "ui/menu.h"
+}
+
+unsigned preview_dpi = 96;
+bool preview_quit = false;
+uint64_t preview_buttons = 0;
+int32_t preview_lx = 0, preview_ly = 0;
+int preview_capture_key = 0;
+int preview_capture_pad = 0;
+
+extern "C" {
+extern const int rt_game_version = 100;
+extern const char rt_port_version[] = "preview";
+
+void rt_log(const char *fmt, ...) {
+    va_list ap;
+    va_start(ap, fmt);
+    vfprintf(stderr, fmt, ap);
+    va_end(ap);
+    fputc('\n', stderr);
+}
+[[noreturn]] void rt_fatal(const char *fmt, ...) {
+    va_list ap;
+    va_start(ap, fmt);
+    vfprintf(stderr, fmt, ap);
+    va_end(ap);
+    fputc('\n', stderr);
+    exit(1);
+}
+void vk_queue_lock(void) {}
+void vk_queue_unlock(void) {}
+void res_sizes(unsigned out[2], unsigned scene[2]) {
+    out[0] = scene[0] = 1920;
+    out[1] = scene[1] = 1080;
+}
+double frame_step_limit_hz(void) { return 60; }
+int romfs_xbox_prompts_ready(void) { return 0; }
+int romfs_xbox_prompts_active(void) { return 0; }
+void gfx_window_apply_settings(void) {}
+void gfx_window_request_close(void) { preview_quit = true; }
+int gfx_window_monitor_size(int *w, int *h) { *w = 2560; *h = 1440; return 1; }
+double gfx_window_refresh_hz(void) { return 60; }
+unsigned gfx_window_dpi(void) { return preview_dpi; }
+const char *gfx_window_present_mode(void) { return "mailbox"; }
+void input_menu(int) {}
+int input_pad_read(uint64_t *b, int32_t *x, int32_t *y) {
+    *b = preview_buttons; *x = preview_lx; *y = preview_ly; return 1;
+}
+int input_pad_layout(void) { return -1; }
+int input_pad_label(int) { return PAD_LABEL_NONE; }
+int input_device_choices(InputDeviceChoice *, int) { return 0; }
+int input_player_connected(int player) { return player == 0; }
+uint32_t input_key_char(int) { return 0; }
+void input_map_snapshot_player(int player, InputMap *m) {
+    static unsigned seen = ~0u;
+    if (seen != cfg_version()) {
+        input_map_configure();
+        seen = cfg_version();
+    }
+    *m = *input_map_player(player);
+}
+int input_capture(int reset, int *id) {
+    if (reset) { preview_capture_key = preview_capture_pad = 0; return INPUT_CAPTURE_NONE; }
+    if (preview_capture_key) {
+        *id = preview_capture_key;
+        preview_capture_key = 0;
+        return *id == KEY_ESCAPE ? INPUT_CAPTURE_CANCEL : INPUT_CAPTURE_KEY;
+    }
+    if (preview_capture_pad) {
+        *id = preview_capture_pad;
+        preview_capture_pad = 0;
+        return INPUT_CAPTURE_PAD;
+    }
+    return INPUT_CAPTURE_NONE;
+}
+void perfmon_mode(int) {}
+void perfmon_set_gpu(const char *, const uint8_t *, int, float) {}
+void perfmon_snapshot(PerfStats *s) {
+    memset(s, 0, sizeof *s);
+    s->fps = 60; s->frame_ms_avg = 16.67f; s->frame_ms_max = 18;
+    for (float &v : s->frame_ms) v = 16.67f;
+    snprintf(s->cpu_name, sizeof s->cpu_name, "Synthetic CPU");
+    snprintf(s->gpu_name, sizeof s->gpu_name, "Synthetic GPU");
+}
+int sysinfo_text(char *buf, size_t n) { return snprintf(buf, n, "Menu preview"); }
+void sysinfo_cpu_name(char *out, size_t n) { snprintf(out, n, "Synthetic CPU"); }
+int sysinfo_log_folder(char *out, size_t n) { if (n) *out = 0; return 0; }
+const char *ov_language(void) { return "en-US"; }
+}
diff --git a/tests/menu_preview_test.py b/tests/menu_preview_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..f7ffdec80b59cbc025b2accf2a9e3101ce7b9253
--- /dev/null
+++ b/tests/menu_preview_test.py
@@ -0,0 +1,230 @@
+"""Run the real menu on a synthetic offscreen Vulkan image.
+
+Usage: py -I tests/menu_preview_test.py [--cc clang++] [--deps DIR] [--out DIR]
+"""
+import argparse
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+TOOLCHAIN = Path(r"F:\dev\age-of-decomp\.cache\toolchain\windows")
+DEFAULT_CC = TOOLCHAIN / "llvm/bin/clang++.exe"
+DEFAULT_DEPS = TOOLCHAIN / "deps"
+
+ROW_HOVER = (500, 310)
+CONTINUE = (1360, 900)
+
+
+def build(cc, deps, out):
+    sources = [
+        "tests/menu_preview.cpp", "tests/menu_preview_stubs.cpp",
+        "runtime/ui/menu.cpp", "runtime/ui/option_rows.cpp", "runtime/ui/binds_page.cpp",
+        "runtime/ui_text.c", "runtime/cfg.c", "runtime/input_map.c",
+        "runtime/platform/common.c", "runtime/platform/win32.c",
+        *("runtime/third_party/imgui/" + f + ".cpp" for f in
+          ("imgui", "imgui_draw", "imgui_tables", "imgui_widgets", "backends/imgui_impl_vulkan")),
+    ]
+    common = ["-O2", "-g", "-Wall", "-fno-strict-aliasing", "-march=x86-64-v3",
+              "-D_WIN32_WINNT=0x0A00", "-I", str(ROOT / "runtime"),
+              "-I", str(ROOT / "runtime/third_party/imgui"),
+              "-I", str(deps / "include"), "-I", str(deps / "include/vma")]
+    objdir = out / "objects"
+    objdir.mkdir(parents=True, exist_ok=True)
+    objects = []
+    log = []
+    for i, source in enumerate(sources):
+        obj = objdir / f"{i}.o"
+        command = [str(cc), *common, *(["-std=c++20"] if source.endswith(".cpp") else ["-x", "c", "-std=gnu11"]),
+                   "-c", str(ROOT / source), "-o", str(obj)]
+        result = subprocess.run(command, capture_output=True, text=True)
+        log.append("$ " + subprocess.list2cmdline(command) + "\n" + result.stdout + result.stderr)
+        if result.returncode:
+            (out / "build.log").write_text("\n".join(log), encoding="utf-8")
+            print(result.stderr, file=sys.stderr)
+            raise RuntimeError(f"compile failed: {source}")
+        objects.append(str(obj))
+    exe = out / "menu-preview.exe"
+    command = [str(cc), *objects, "-o", str(exe), "-L", str(deps / "lib"),
+               "-lvulkan-1", "-lpsapi", "-lbcrypt", "-luser32", "-lgdi32",
+               "-lwinmm", "-lpdh", "-lrstrtmgr", "-lshell32", "-lole32",
+               "-l:libc++.a", "-l:libc++abi.a", "-l:libunwind.a", "-l:libwinpthread.a"]
+    result = subprocess.run(command, capture_output=True, text=True)
+    log.append("$ " + subprocess.list2cmdline(command) + "\n" + result.stdout + result.stderr)
+    (out / "build.log").write_text("\n".join(log), encoding="utf-8")
+    if result.returncode:
+        print(result.stderr, file=sys.stderr)
+        raise RuntimeError("link failed")
+    return exe
+
+
+def scenarios():
+    yield "keyboard", """
+open
+key DownArrow tap
+key RightArrow tap
+expect WINDOW_SIZE=1366x768
+key E tap
+shot keyboard-tab-game
+key Q tap
+key RightArrow tap
+expect FULLSCREEN=1
+key Escape tap
+expect-open 0
+frames 2
+expect-ini WINDOW_SIZE=1366x768
+expect-ini FULLSCREEN=1
+"""
+    yield "gamepad", """
+open
+padtap DOWN
+padtap UP
+padtap A
+expect FULLSCREEN=1
+padtap R
+shot gamepad-tab-game
+stick 0 -1
+frames 2
+shot gamepad-stick-down
+stick 0 0
+padtap B
+expect-open 0
+"""
+    yield "mouse", f"""
+open
+mouse {ROW_HOVER[0]} {ROW_HOVER[1]}
+shot mouse-hover
+click {CONTINUE[0]} {CONTINUE[1]}
+expect-open 0
+"""
+    yield "remap", """
+open
+key E tap
+key E tap
+key E tap
+key DownArrow tap
+key DownArrow tap
+key DownArrow tap
+key DownArrow tap
+key DownArrow tap
+key DownArrow tap
+key DownArrow tap
+key DownArrow tap
+key DownArrow tap
+key DownArrow tap
+key DownArrow tap
+key DownArrow tap
+key DownArrow tap
+key Enter tap
+key K tap
+sleep 500
+expect BIND_MENU=key:k, pad:default
+expect-ini BIND_MENU=key:k, pad:default
+"""
+    yield "quit", "open\n" + "key DownArrow tap\n" * 30 + """
+key RightArrow tap
+key Enter tap
+expect-quit 1
+"""
+    yield "resize-and-cycle", """
+open
+size 1280x800
+lang ru
+shot resized-ru
+close
+key F10 tap
+expect PERF_OVERLAY=fps
+key F10 tap
+expect PERF_OVERLAY=full
+"""
+    yield "remap-pad", """
+open
+key E tap
+key E tap
+key E tap
+""" + "key DownArrow tap\n" * 13 + """
+key RightArrow tap
+key RightArrow tap
+key Enter tap
+padtap A
+sleep 500
+expect BIND_MENU=key:default, pad:east
+expect-ini BIND_MENU=key:default, pad:east
+"""
+
+
+def shots():
+    sizes = [(1280, 720, 96), (1280, 800, 96), (1920, 1080, 96),
+             (2560, 1440, 96), (3840, 2160, 96), (1280, 720, 144)]
+    for lang in ("en", "ru"):
+        for w, h, dpi in sizes:
+            suffix = "-dpi144" if dpi != 96 else ""
+            commands = ["open", "frames 3"]
+            for tab in range(6):
+                commands.append(f"shot {lang}-{w}x{h}{suffix}-tab{tab}")
+                if tab != 5:
+                    commands.append("key E tap")
+            yield f"shots-{lang}-{w}x{h}{suffix}", "\n".join(commands), w, h, dpi, lang
+    yield "overlay", """
+set PERF_OVERLAY=full
+sleep 100
+shot overlay-full
+set PERF_OVERLAY=fps
+sleep 650
+shot overlay-fps
+""", 1920, 1080, 96, "en"
+
+
+def run(exe, out, name, script, w=1920, h=1080, dpi=96, lang="en"):
+    scratch = Path(tempfile.mkdtemp(prefix=name + "-", dir=out / "runs"))
+    local_exe = scratch / exe.name
+    shutil.copy2(exe, local_exe)
+    script_path = scratch / "scenario.txt"
+    script_path.write_text(script, encoding="utf-8")
+    command = [str(local_exe), "--size", f"{w}x{h}", "--dpi", str(dpi),
+               "--lang", lang, "--script", str(script_path), "--out", str(out)]
+    try:
+        result = subprocess.run(command, capture_output=True, text=True, timeout=300)
+        log = "$ " + subprocess.list2cmdline(command) + "\n" + result.stdout + result.stderr
+        (scratch / "run.log").write_text(log, encoding="utf-8")
+        if result.returncode:
+            print(f"FAIL {name}: exit {result.returncode}; {scratch / 'run.log'}", flush=True)
+            print(result.stderr, file=sys.stderr)
+            return False
+    except subprocess.TimeoutExpired as e:
+        (scratch / "run.log").write_text(str(e), encoding="utf-8")
+        print(f"FAIL {name}: timeout; {scratch / 'run.log'}", flush=True)
+        return False
+    print(f"PASS {name}", flush=True)
+    return True
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--cc", default=str(DEFAULT_CC) if DEFAULT_CC.is_file() else shutil.which("clang++"))
+    parser.add_argument("--deps", type=Path, default=DEFAULT_DEPS)
+    parser.add_argument("--out", type=Path, default=ROOT / "build/tests/menu-preview")
+    parser.add_argument("--shots-only", action="store_true")
+    args = parser.parse_args()
+    if not args.cc:
+        parser.error("pass --cc with clang++")
+    out = args.out.resolve()
+    out.mkdir(parents=True, exist_ok=True)
+    (out / "runs").mkdir(exist_ok=True)
+    try:
+        exe = build(args.cc, args.deps.resolve(), out)
+    except RuntimeError as e:
+        print(f"FAIL build: {e}; see {out / 'build.log'}", file=sys.stderr)
+        return 1
+    results = [run(exe, out, name, script, w, h, dpi, lang)
+               for name, script, w, h, dpi, lang in shots()]
+    if not args.shots_only:
+        results.extend(run(exe, out, name, script) for name, script in scenarios())
+    return 0 if all(results) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
