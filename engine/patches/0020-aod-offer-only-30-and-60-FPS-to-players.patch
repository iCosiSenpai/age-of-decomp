From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Age of Decomp patch queue <aod-patches@localhost>
Date: Thu, 19 Nov 2026 12:04:43 +0100
Subject: [PATCH] aod: offer only 30 and 60 FPS to players

Above 60 the game's fixed step runs the whole game faster, so the menu and the
settings table offer 30 and 60. A value an older menu saved, or any other value,
now plays at 60 instead of stopping the game. 90 and 120 stay available to the
developer rate experiments (native unlock or EXPERIMENTAL_RATE=1).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runtime/cfg.c                  |  2 +-
 runtime/frame_rate.c           | 13 ++++++++++---
 runtime/nvn_api_obj.c          |  3 +++
 runtime/ui/menu.cpp            |  8 ++++----
 runtime/ui_text.c              | 12 +++---------
 tests/hwaoi/test_hwaoi_rate.py | 22 ++++++++++++++++------
 6 files changed, 37 insertions(+), 23 deletions(-)

diff --git a/runtime/cfg.c b/runtime/cfg.c
index a9967cb9d7999cdeb12b269881878f8ae5a77044..db8658fed6ca678a55b2b396eb832d52bfe30152 100644
--- a/runtime/cfg.c
+++ b/runtime/cfg.c
@@ -117,7 +117,7 @@ static const CfgMeta metas[] = {
     {"DEVICE_PROFILE", "auto", "auto|desktop|deck", RESTART},
     // Game
 #if RT_TARGET_HWAOI
-    {"FPS_LIMIT", "60", "30|60|90|120", LIVE},
+    {"FPS_LIMIT", "60", "30|60", LIVE},
 #else
     {"FPS_LIMIT", "60", "30|40|45|60|90|120|144|display", LIVE},
 #endif
diff --git a/runtime/frame_rate.c b/runtime/frame_rate.c
index 4167c3e4a5a9d68935090f7f064130bc82216068..70f32b6ee17a2ea462c87e359c794dd25c209e62 100644
--- a/runtime/frame_rate.c
+++ b/runtime/frame_rate.c
@@ -129,9 +129,16 @@ static int limit_parse(void) {
     if (RT_TARGET_HWAOI) {
         if (!strcmp(e, "30")) return 30;
         if (!strcmp(e, "60")) return 60;
-        if (!strcmp(e, "90")) return 90;
-        if (!strcmp(e, "120")) return 120;
-        rt_fatal("frame rate: HWAoI FPS_LIMIT must be 30, 60, 90 or 120");
+        // 90 and 120 remain for the developer rate experiments (native unlock or EXPERIMENTAL_RATE=1). Players get 30
+        // or 60; another value, such as one an older menu saved, plays at 60.
+        const char *experiment = cfg_get("TOTK_EXPERIMENTAL_RATE");
+        if (hwaoi_rate_word || (experiment && !strcmp(experiment, "1"))) {
+            if (!strcmp(e, "90")) return 90;
+            if (!strcmp(e, "120")) return 120;
+            rt_fatal("frame rate: HWAoI FPS_LIMIT must be 30, 60, 90 or 120");
+        }
+        rt_log("frame rate: HWAoI FPS_LIMIT=%s is not 30 or 60; 60", e);
+        return 60;
     }
     if (!strcmp(e, "display")) return 0;
     char *end;
diff --git a/runtime/nvn_api_obj.c b/runtime/nvn_api_obj.c
index a011ba53df488a47cf906056c1ab6e58b027a464..3a19fc22149718ade2cac4ce069cd2270e4dc608 100644
--- a/runtime/nvn_api_obj.c
+++ b/runtime/nvn_api_obj.c
@@ -901,6 +901,9 @@ static uint64_t present_period(const win_t *o) {
     {
         uint64_t period;
         const char *value = cfg_value("TOTK_FPS_LIMIT");
+        // Players get 30 or 60 (frame_rate.c); faster targets need a developer rate experiment.
+        if (!frame_step_native_rate() && (!rate_experiment || strcmp(rate_experiment, "1")) && strcmp(value, "30"))
+            value = "60";
         if (!hwaoi_rate_period(value, &period))
             rt_fatal("HWAoI requires FPS_LIMIT 30, 60, 90 or 120");
         int experimental = period < 1000000000ull / 60;
